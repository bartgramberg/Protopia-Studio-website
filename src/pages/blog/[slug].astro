---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import ProjectImageSlider from '../../components/ProjectImageSlider.astro'
import { getCollection, render } from 'astro:content'
import { t } from '../../i18n/translations'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id }) => id.startsWith('nl/'))
  return posts.map(p => ({
    params: { slug: p.id.replace('nl/', '') },
    props:  { post: p },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const locale = 'nl'
const tr = t(locale)
const slug = post.id.replace('nl/', '')
const dateStr = post.data.date.toLocaleDateString('nl-NL', {
  day: 'numeric', month: 'long', year: 'numeric'
})

// Combine cover + gallery images for slider
const allImages = post.data.images.length > 0
  ? [post.data.image, ...post.data.images].filter(Boolean) as string[]
  : post.data.image
    ? [post.data.image]
    : []
---
<Base title={post.data.title} description={post.data.description ?? post.data.title} locale={locale} altHref={`/en/blog/${slug}`}>
  <Nav locale={locale} altHref={`/en/blog/${slug}`} activePage="blog" />

  <!-- Hero -->
  <div class="page-hero bg-creme pt-16 sm:pt-20 lg:pt-[88px] pb-10 sm:pb-12 lg:pb-14">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-magenta mb-4 inline-block">{post.data.category}</span>
      <h1 class="text-[clamp(30px,8vw,52px)] font-bold leading-[1.12] tracking-[-0.025em] text-green text-balance mb-4">
        {post.data.title}
      </h1>
      {post.data.description && (
        <p class="text-[16px] sm:text-[18px] text-mid leading-[1.75] max-w-[680px] mb-5">{post.data.description}</p>
      )}
      <p class="text-[13px] text-light">{post.data.author} · {dateStr} · {post.data.readingTime} min leestijd</p>
    </div>
  </div>

  <!-- Image(s): single or slider -->
  {allImages.length > 0 && (
    <ProjectImageSlider images={allImages} imageAlt={post.data.title} />
  )}

  <!-- Article body -->
  <article class="py-12 sm:py-14 lg:py-16">
    <div class="max-w-[740px] mx-auto px-5 sm:px-8 lg:px-10">
      <div class="prose prose-lg text-mid prose-headings:text-green prose-headings:font-bold prose-strong:text-dark prose-a:text-green prose-a:no-underline hover:prose-a:text-magenta prose-li:marker:text-green">
        <Content />
      </div>
    </div>
  </article>

  <!-- Back link -->
  <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10 pb-12 sm:pb-14 lg:pb-16">
    <a href="/blog" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-mid before:content-['<'] hover:text-green transition-colors">
      {tr.blog.eyebrow}
    </a>
  </div>

  <Footer locale={locale} />
</Base>
