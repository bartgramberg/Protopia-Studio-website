---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'

const locale = 'en'
---
<Base title="Message not sent" description="Your message could not be sent." locale={locale} altHref="/niet-verzonden">
  <Nav locale={locale} altHref="/niet-verzonden" activePage="contact" />

  <main class="bg-creme">
    <section class="min-h-[60vh] py-20 sm:py-24 lg:py-28">
      <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
        <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">Contact</span>
        <h1 class="text-[clamp(32px,9vw,58px)] font-bold leading-[1.1] tracking-[-0.025em] text-green text-balance mb-5">Your message could not be sent.</h1>
        <p class="text-[16px] sm:text-[18px] text-mid leading-[1.75] max-w-[680px]">Please try again, or email us directly at info@protopiastudio.nl.</p>
        <a href="/en/contact/" class="mt-8 inline-flex items-center justify-center px-[26px] py-[13px] rounded-pill text-[15px] font-semibold bg-green text-white hover:bg-green-dark transition-colors">
          Back to contact
        </a>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</Base>
