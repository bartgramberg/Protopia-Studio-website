---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import { t } from '../../i18n/translations'
const locale = 'en'
const tr = t(locale)
---
<Base title="Why Regeneration" description="The great challenges of our time require more than limiting damage. They require active restoration." locale={locale} altHref="/waarom">
  <Nav locale={locale} altHref="/waarom" activePage="waarom" />

  <!-- Hero -->
  <div class="page-hero bg-creme pt-16 sm:pt-20 lg:pt-[88px] pb-12 sm:pb-14 lg:pb-16">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">Why Regeneration</span>
      <h1 class="text-[clamp(32px,9vw,58px)] font-bold leading-[1.1] tracking-[-0.025em] text-green text-balance mb-5">Why regeneration?</h1>
      <p class="text-[16px] sm:text-[18px] text-mid leading-[1.75] max-w-[680px]">The great challenges of our time require more than limiting damage. They require active restoration — of ecosystems, of communities, of the balance between people and nature. Not waiting for the perfect solution, but taking the best step possible now. That is regeneration.</p>
    </div>
  </div>

  <!-- Spectrum -->
  <section class="py-14 sm:py-16 lg:py-20">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">The spectrum</span>
      <h2 class="text-[clamp(28px,3.5vw,42px)] font-bold leading-[1.15] tracking-[-0.02em] text-green text-balance">Degenerative. Sustainable. Regenerative.</h2>
      <div class="grid gap-5 md:grid-cols-3 mt-10">
        <div class="bg-white border border-[rgba(72,115,91,0.15)] rounded-lg p-8 shadow-[0_2px_8px_rgba(26,26,26,0.04)]">
          <img src="/assets/spectrum/degeneratief.png" alt="Degenerative — polluted city illustration" class="w-full aspect-[5/4] object-contain mb-4" />
          <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-light mb-2.5">Step 1</div>
          <div class="text-[20px] font-bold text-green mb-2.5">Degenerative</div>
          <p class="text-[14px] text-mid leading-[1.7]">Our current way of life has an irreversible impact on the world. This degenerative system — extractive, linear, based on scarcity and depletion of natural resources — is unsustainable.</p>
        </div>
        <div class="bg-white border border-[rgba(72,115,91,0.15)] rounded-lg p-8 shadow-[0_2px_8px_rgba(26,26,26,0.04)]">
          <img src="/assets/spectrum/sustainable.png" alt="Sustainable — city in balance illustration" class="w-full aspect-[5/4] object-contain mb-4" />
          <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-light mb-2.5">Step 2</div>
          <div class="text-[20px] font-bold text-green mb-2.5">Sustainable</div>
          <p class="text-[14px] text-mid leading-[1.7]">Fortunately, we are collectively becoming more aware of this, and sustainability thinking has taken off over the past decades. Sustainability is a necessary, but ultimately imperfect position. Limiting damage and maintaining the status quo is not enough.</p>
        </div>
        <div class="bg-white border border-[rgba(72,115,91,0.15)] rounded-lg p-8 shadow-[0_2px_8px_rgba(26,26,26,0.04)]">
          <img src="/assets/spectrum/regeneratief.png" alt="Regenerative — green city illustration" class="w-full aspect-[5/4] object-contain mb-4" />
          <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-light mb-2.5">Step 3 — the direction</div>
          <div class="text-[20px] font-bold text-magenta mb-2.5">Regenerative</div>
          <p class="text-[14px] text-mid leading-[1.7]">The next step is regeneration: actively restoring natural and social ecosystems. A systemic view of the world based on abundance, reciprocity and resilience, where the goal is to give back more than you take.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Four application areas -->
  <section class="py-14 sm:py-16 lg:py-20 bg-creme">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">Four application areas</span>
      <h2 class="text-[clamp(28px,3.5vw,42px)] font-bold leading-[1.15] tracking-[-0.02em] text-green text-balance">Not utopia, but concrete steps.</h2>
      <div class="grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-14 items-start mt-10">
        <div class="flex flex-col gap-3.5">
          <p class="text-[16px] text-mid leading-[1.7]">Regeneration is not an abstract promise. It is the direction you choose with every project, every intervention, every decision — whether it concerns a city, a business or a product.</p>
          <p class="text-[16px] text-mid leading-[1.7]">Protopia works in the tension between regenerative vision and economic reality, and makes that tension productive.</p>
          <p class="text-[16px] text-mid leading-[1.7]">Not by advising from the sidelines, but by designing, building and realising.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="bg-white border border-[rgba(72,115,91,0.18)] rounded-lg p-5 flex flex-col justify-center min-h-[110px]">
            <div class="text-[14px] font-bold text-green mb-1">Environments</div>
            <div class="text-[12.5px] text-mid leading-[1.55]">Living socio-ecological systems that give back more than they take.</div>
          </div>
          <div class="bg-white border border-[rgba(72,115,91,0.18)] rounded-lg p-5 flex flex-col justify-center min-h-[110px]">
            <div class="text-[14px] font-bold text-green mb-1">Businesses</div>
            <div class="text-[12.5px] text-mid leading-[1.55]">Business models that create ecological and social value alongside financial.</div>
          </div>
          <div class="bg-white border border-[rgba(72,115,91,0.18)] rounded-lg p-5 flex flex-col justify-center min-h-[110px]">
            <div class="text-[14px] font-bold text-green mb-1">Products</div>
            <div class="text-[12.5px] text-mid leading-[1.55]">Designs that strengthen the living systems on which they depend.</div>
          </div>
          <div class="bg-green rounded-lg p-5 flex flex-col justify-center min-h-[110px]">
            <div class="text-[9.5px] font-semibold uppercase tracking-[0.14em] text-white/70 mb-1.5">Our role</div>
            <div class="text-[15px] font-bold text-white mb-1.5">From vision to prototype to realisation.</div>
            <div class="text-[12.5px] text-white/90 leading-[1.6]">We build what would otherwise not have existed.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 Principles -->
  <section class="py-14 sm:py-16 lg:py-20">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">8 regenerative principles as compass</span>
      <h2 class="text-[clamp(28px,3.5vw,42px)] font-bold leading-[1.15] tracking-[-0.02em] text-green text-balance">Discover our eight principles.</h2>
      <p class="text-[16px] sm:text-[17px] text-mid leading-[1.75] max-w-[680px] mt-4">Protopia Studio has developed eight regenerative design principles. They describe not an end state, but a direction — of more life, more abundance, and more capacity for systems to renew themselves. These principles are both a design attitude and an assessment tool: for cities, for organisations, for products.</p>

      <div class="mt-8">
        <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-light mb-4">Choose a principle</div>
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4" id="principles-grid">
          {[
            { num: '01', p: 1, title: 'Design from one living system',  desc: 'Design from one integrated socio-ecological whole.',     img: '/assets/principes/01-holistic.png' },
            { num: '02', p: 2, title: 'Give more than you take',        desc: 'Give more back than you take on balance.',              img: '/assets/principes/02-resources.png' },
            { num: '03', p: 3, title: 'Move with natural and cultural rhythms', desc: 'Move with cycles, seasons and timing.',        img: '/assets/principes/03-cycli.png' },
            { num: '04', p: 4, title: 'Design for natural self-organisation', desc: 'Create conditions — give space, not control.',   img: '/assets/principes/04-resilience.png' },
            { num: '05', p: 5, title: 'Pay attention to all life',      desc: 'Give equal attention to human and non-human life.',      img: '/assets/principes/05-inclusief.png' },
            { num: '06', p: 6, title: 'Design for future generations',  desc: 'Design for future generations.',                         img: '/assets/principes/06-intergenerationeel.png' },
            { num: '07', p: 7, title: 'Strengthen regenerative culture', desc: 'Strengthen the culture that carries regeneration.',     img: '/assets/principes/07-social.png' },
            { num: '08', p: 8, title: 'Govern as a community',          desc: 'Build shared ownership and collective stewardship.',     img: '/assets/principes/08-commons.png' },
          ].map(item => (
            <button
              class="px-pcard text-left border border-[rgba(72,115,91,0.12)] bg-creme rounded-lg overflow-hidden transition-all duration-200 hover:border-green hover:shadow-[0_6px_20px_rgba(72,115,91,0.12)] hover:-translate-y-0.5"
              data-p={item.p}
            >
              <div class="px-card-img">
                <img src={item.img} alt={item.title} />
              </div>
              <div class="px-3 py-3 sm:px-3.5 sm:py-3.5">
                <div class="text-[21px] font-extrabold text-magenta leading-none mb-1.5">{item.num}</div>
                <div class="text-[13px] font-bold text-green leading-snug mb-1">{item.title}</div>
                <p class="text-[11px] text-mid leading-[1.45]">{item.desc}</p>
              </div>
            </button>
          ))}
        </div>

        <!-- Detail panel -->
        <div id="px-detail" class="mt-7 bg-creme rounded-xl overflow-hidden opacity-0 translate-y-2 transition-all duration-300">
          <div id="px-detail-strip" class="h-[5px] bg-green"></div>
          <div class="p-5 sm:p-8 relative">
            <div id="px-detail-num" class="absolute top-[18px] right-5 sm:right-7 text-[44px] sm:text-[64px] font-light italic text-green/20 leading-none tracking-[-2px]">01</div>
            <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-light mb-2.5">Choose a domain</div>
            <div class="flex gap-2 flex-wrap mb-5 pr-16 sm:pr-24" id="domain-tabs">
              <button class="px-domain-tab active" data-domain="cities">Environments</button>
              <button class="px-domain-tab" data-domain="business">Businesses</button>
              <button class="px-domain-tab" data-domain="products">Products</button>
            </div>
            <h3 id="px-detail-title" class="text-[20px] sm:text-[22px] font-bold text-green mb-1.5 leading-snug max-w-[82%] sm:max-w-[78%]">Design from one living system</h3>
            <p id="px-detail-activating" class="text-[13px] italic text-magenta mb-3.5"></p>
            <div id="px-detail-short" class="text-[13px] text-mid leading-[1.7] p-4 bg-white rounded-lg mb-4"></div>
            <div id="px-detail-body" class="text-[13.5px] text-[#333] leading-[1.8]"></div>
            <div class="flex flex-wrap justify-between items-center gap-3 mt-5 pt-4 border-t border-[rgba(72,115,91,0.12)]">
              <button id="px-nav-prev" class="px-nav-btn" onclick="pxNavigate(-1)">← Previous</button>
              <span id="px-nav-progress" class="text-[11px] text-light tracking-[0.1em]">1 / 8</span>
              <button id="px-nav-next" class="px-nav-btn" onclick="pxNavigate(1)">Next →</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <div class="bg-green py-14 sm:py-16 lg:py-[72px] text-center">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <h2 class="text-[clamp(26px,3vw,38px)] font-bold text-white leading-[1.2] mb-2.5 text-balance">Regenerative knowledge in practice</h2>
      <p class="text-[16px] text-white/70 mb-7 max-w-[820px] mx-auto leading-[1.7]">Regenerative theory only gains power when it is rooted in practice. That is why we actively build a knowledge base of regenerative initiatives and approaches worldwide. That database forms the backbone of our work — so that for every challenge we can draw on what already works, and translate it to the context of our clients. See also our exploratory research Amsterdam Regenerative City.</p>
      <div class="flex gap-3.5 justify-center flex-wrap">
        <a href="/en/projects" class="inline-flex items-center gap-1.5 px-[26px] py-[11px] rounded-pill text-[14px] font-semibold text-white border border-white/50 hover:bg-white/10 transition-colors">View projects</a>
        <a href="/en/contact" class="inline-flex items-center gap-1.5 px-[26px] py-[11px] rounded-pill text-[14px] font-semibold text-white border border-white/50 hover:bg-white/10 transition-colors">Get in touch</a>
      </div>
    </div>
  </div>

  <Footer locale={locale} />
</Base>

<style>
.px-domain-tab {
  cursor: pointer;
  border: 1px solid var(--color-border, #DEDAD4);
  background: white;
  color: #4A4A4A;
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
  padding: 9px 22px;
  border-radius: 999px;
  transition: all 0.15s;
}
.px-domain-tab:hover { background: #F2EFE9; color: #48735B; }
.px-domain-tab.active { color: white; }
.px-domain-tab[data-domain="cities"].active { background: #48735B; border-color: #48735B; }
.px-domain-tab[data-domain="business"].active { background: #347EBF; border-color: #347EBF; }
.px-domain-tab[data-domain="products"].active { background: #D90D7D; border-color: #D90D7D; }
.px-card-img {
  height: 118px;
  overflow: hidden;
  background: #F2EFE9;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
}
.px-card-img img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
}
@media (min-width: 640px) {
  .px-card-img { height: 150px; }
}
@media (min-width: 1024px) {
  .px-card-img { height: 170px; }
}
.px-pcard.active { border-color: #D90D7D !important; box-shadow: 0 6px 20px rgba(217,13,125,0.18) !important; }
.px-pcard.active .principle-title { color: #D90D7D; }
#px-detail.visible { opacity: 1 !important; transform: translateY(0) !important; }
#px-detail:not(.visible) { display: none; }
#px-detail-body :global(p) { margin: 0; }
#px-detail-body :global(p + p) { margin-top: 1.2rem; }
#px-detail-strip.business { background: #347EBF; }
#px-detail-strip.products { background: #D90D7D; }
.px-nav-btn {
  cursor: pointer;
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  color: #48735B;
  background: white;
  border: 1px solid #DEDAD4;
  padding: 7px 16px;
  border-radius: 999px;
  transition: all 0.15s;
}
.px-nav-btn:hover { background: #48735B; color: white; border-color: #48735B; }
.px-nav-btn:disabled { opacity: 0.4; cursor: default; background: white; color: #7A7A7A; }
</style>

<script>
const PX_NAMES = ['Design from one living system','Give more than you take','Move with natural and cultural rhythms','Design for natural self-organisation','Pay attention to all life','Design for future generations','Strengthen regenerative culture','Govern as a community'];
const PX_DATA = {
  1:{cities:{activating:"Design from the idea of one living socio-ecological system",short:"Design from the understanding that the city is one integrated, continuously changing socio-ecological system, embedded in a larger bioregional context.",full:"<p>A city is a living socio-ecological system: a continuously changing whole in which ecology, social and cultural structures, and economy are inextricably interwoven. Those three dimensions strengthen or undermine each other continuously. Regenerative design begins with recognizing that reciprocity, and with designing solutions that serve multiple functions simultaneously.</p><p>The city is never a closed system. It is part of a larger whole: the neighborhood is part of the city, the city of the region, the region of a broader landscape. Each scale level is simultaneously an autonomous unit and part of a larger whole. An intervention in a neighborhood works through to the level of city and region. And conversely, what happens at the regional level determines what is possible at the neighborhood level. Actively connecting scale levels is a core challenge of regenerative design.</p><p>Interventions are not evaluated by a single goal but by their contribution to the whole. Think of rainwater management that simultaneously strengthens biodiversity, play space, and social encounter. Or a food program that simultaneously builds soil quality, social cohesion, and local economy.</p>"},business:{activating:"Act from the idea of one living socio-ecological system",short:"Act from the understanding that the organization is one integrated, continuously changing socio-ecological system, embedded in the living context of value chains, communities, and bioregions.",full:"<p>An organization is a living socio-ecological system: a continuously changing whole in which ecology, social and cultural structures, and economy are inextricably interwoven. Those three dimensions strengthen or undermine each other continuously. Regenerative business begins with recognizing that reciprocity, and with making decisions that serve multiple value dimensions simultaneously.</p><p>An organization is never a closed system. It is part of a larger whole: the team is part of the organization, the organization of the supply chain and industry, the industry of the bioregion. Each scale level is simultaneously autonomous and part of a larger whole. A decision in a team works through to the supply chain and the community. And conversely, what happens at the bioregional level shapes what is possible at the organizational level. Actively connecting these scale levels is a core challenge of regenerative business.</p><p>Business decisions are not evaluated by financial return alone, but by their contribution to the living whole. Think of a hiring practice that simultaneously builds organizational capacity, strengthens community relationships, and creates ecological opportunity. Or a sourcing decision that builds soil health, local economic resilience, and long-term material security simultaneously.</p>"},products:{activating:"Design from the idea of one living system — from material to end of life",short:"Design from the understanding that a product exists within one integrated, continuously changing socio-ecological system — from material origin through use to end of life — and that every design decision affects this larger whole.",full:"<p>A product is not an isolated artifact but part of a living socio-ecological system: a continuously changing whole in which ecology, social and cultural structures, and economy are inextricably woven into every stage of its life. Those three dimensions strengthen or undermine each other across material origin, production, use, and end of life. Regenerative product design begins with recognizing that reciprocity, and with designing objects that serve multiple systems simultaneously.</p><p>A product is never a closed system. It is part of a larger whole: the material is part of the product, the product of the use ecosystem, the use ecosystem of the supply chain and bioregion. Each scale level is simultaneously autonomous and part of a larger whole. A material choice works through to the producing ecosystem, the user's behavior, and the end-of-life landscape. Actively considering these scale connections — from fiber to field to landfill — is a core challenge of regenerative product design.</p><p>Products are not evaluated by function or price alone, but by their contribution to the living whole. Think of a material choice that simultaneously supports soil health, provides livelihood for a farming community, and creates a beautiful, lasting product. Or a packaging design that returns biological nutrients to soil, educates users about natural systems, and eliminates regional waste infrastructure costs.</p>"}},
  2:{cities:{activating:"Give more back than you take",short:"Design based on circular, local, and renewable sources and flows. Per balance, an intervention yields more than it costs.",full:"<p>Regenerative resource management goes beyond closing cycles. The goal is a system that adds more net than it consumes: that builds soil fertility instead of depleting it, increases biodiversity, and accumulates social and economic value. Not just maintaining, but actively building.</p><p>Design based on circular, local, and renewable flows: resources remain in the system, are actively built up, and do not become depleted. This includes soil building, closed cycles for water, energy, materials, and nutrients, local use of residual flows, and minimizing loss.</p><p>A regenerative city aims to give its environment more back than it takes. Not as an absolute claim, but as compass and direction of action. That relationship is reciprocal: the city feeds the region, and the region feeds the city. Food, water, materials, ecological services — they flow in both directions. That reciprocity must be consciously designed into food rings, restored water cycles, and biobased material production.</p>"},business:{activating:"Give more back than you take",short:"Operate based on circular, regenerative flows of natural, human, social, and financial capital. Per balance, a business creates more across all capitals than it consumes.",full:"<p>Regenerative resource management in business goes beyond reducing footprint. The goal is an organization that per balance adds more than it consumes across all capitals: that builds natural capital instead of depleting it, increases human flourishing, and accumulates social and economic value. Not just maintaining, but actively building.</p><p>Operate based on circular, regenerative flows across all capitals: natural capital (ecosystems, materials, water, soil), human capital (people's health, skills, and wellbeing), social capital (trust, relationships, knowledge commons), and financial capital. Resources remain in systems, are actively built up, and do not become depleted. This encompasses soil health in supply chains, closed cycles for water, energy, and materials, local use of residual flows, and the minimization of loss.</p><p>A regenerative business aims to give its context more back than it takes. Not as an absolute claim, but as compass and direction. That relationship is reciprocal: the organization feeds the communities it operates in, the ecosystems it depends on, and the people who work within it — and those communities, ecosystems, and people feed the organization in return. That reciprocity must be consciously designed into supply chains, value chains, and governance structures — not as a CSR add-on, but as the core logic of value creation.</p>"},products:{activating:"Give more back than you take",short:"Design based on circular biological and technical material flows. Per lifecycle, a product contributes more to living systems than it extracts.",full:"<p>Regenerative resource management in product design goes beyond reducing material footprint. The goal is a product that per lifecycle adds more to living systems than it consumes: that builds soil health rather than depleting it, supports biodiversity, and creates lasting social and economic value. Not just minimizing harm, but actively building.</p><p>Design based on circular material flows: every material belongs to either a biological cycle (safe, benign return to soil and living systems) or a technical cycle (continuous reuse without quality loss). Materials remain in their appropriate cycle, are actively kept at highest value, and do not cascade toward landfill. This encompasses careful material selection, design for disassembly and return, the use of regeneratively sourced feedstocks, and the elimination of persistent toxins.</p><p>A regenerative product aims to give the ecosystems it touches more back than it takes. Not as an absolute claim, but as compass and direction. That relationship is reciprocal: the product draws from living systems and must be designed to return value to them — in biological nutrients that build soil, technical materials that stay in productive use, and cultural value that supports communities and practices of care.</p>"}},
  3:{cities:{activating:"Move with natural and socio-cultural rhythms and patterns",short:"Design in alignment with natural and cultural patterns, cycles, and timing.",full:"<p>Design in alignment with natural and cultural patterns, cycles, and timing: day and night, seasons, growth phases, recovery periods. Respect natural timescales and develop in the rhythm of nature. This calls for patience, timing, and letting go of linear control. A state of continuous change is not seen as a problem but as a starting point for design.</p><p>The impulse to want to control and predict everything is deeply rooted in how we plan and build cities. Regenerative design calls for a different posture: trusting that nature and society find their own balance, and leaving room for spontaneous development. That does not mean passive watching. As designers we have agency: we can make targeted system interventions that accelerate recovery. The art is distinguishing between steering and controlling.</p><p>Interventions are aligned with natural and cultural processes: the timing of construction, plant selection according to succession, seasonal activities, the slow building of soil and community. So that designs move with the intrinsic tempos of people, nature, and landscape.</p>"},business:{activating:"Move with natural, market, and organizational rhythms and patterns",short:"Operate in alignment with natural, market, and organizational patterns, cycles, and timing. Continuous change is a starting point, not a problem to be managed.",full:"<p>Operate in alignment with natural, market, and organizational patterns, cycles, and timing: seasons of growth and recovery, market cycles, organizational development phases, innovation rhythms. Respect natural timescales and develop at the rhythm of the systems you operate within. This calls for patience, timing, and letting go of the assumption that linear growth is the natural state. Continuous change is not a problem to be managed but a starting point for strategy.</p><p>The impulse to control and predict everything is deeply embedded in how organizations are run. Regenerative business calls for a different posture: trusting that organizations and markets find their own balance, and creating space for emergence. That does not mean passive watching. Leaders have agency: targeted systemic interventions can accelerate positive change. The art is distinguishing between steering and controlling.</p><p>Business decisions are timed with natural and organizational processes: the rhythm of hiring and onboarding, the seasons of fundraising and harvest, the slow building of trust and culture, the fallow periods of organizational recovery. So that strategies move with the intrinsic tempos of people, markets, and ecosystems — rather than overriding them with artificial urgency or forced growth.</p>"},products:{activating:"Design with natural material lifecycles and use rhythms",short:"Design in alignment with natural material lifecycles, use patterns, and cultural rhythms. Build for aging and repair, not for planned obsolescence.",full:"<p>Design in alignment with natural material lifecycles, use patterns, and cultural rhythms: the aging of wood and leather, the seasonal relevance of certain objects, the maintenance and repair cycles of well-made things. Respect natural timescales and design for the rhythm of materials and communities. This calls for patience, timing, and the rejection of planned obsolescence as a design strategy. Continuous change in materials and use is not a problem to manage but a starting point for design.</p><p>The impulse to engineer away all change — to create permanently \"new\" products through planned replacement cycles — is deeply embedded in how products are developed. Regenerative product design calls for a different posture: trusting that materials, users, and ecosystems have their own rhythms, and creating space for aging, adaptation, and succession. That does not mean passive design. Designers have agency: designing for repair, patina, modularity, and material return can shape how products move through the world. The art is distinguishing between designing for change and designing for obsolescence.</p><p>Products are designed in alignment with natural and cultural processes: materials sourced at their ecological peak, design for successional upgrades rather than full replacement, maintenance timed to seasons or use thresholds, the slow building of user attachment and skill. So that products move with the intrinsic rhythms of materials, makers, and communities.</p>"}},
  4:{cities:{activating:"Design for natural self-organization",short:"Design places where systems can organize, adapt, and repair themselves. Create conditions, remove blockages, give space.",full:"<p>Design places where systems can self-organize, adapt, and repair themselves. Stimulate diversity, functional redundancy, and decentralized connected networks so that systems can absorb shocks, become resilient, and adapt without central control. Continuous change becomes a source of improvement rather than threat.</p><p>Self-organization is primally an ecological principle: natural processes are given space and freedom, in a dynamic balance. There is trust in the self-regulating capacity of nature, with as little human intervention as possible. When intervention becomes necessary, it proceeds from a cyclical process of observing, evaluating, and adjusting. But self-organization also has a social dimension: communities that self-organize, that take on collective stewardship, that adapt to change.</p><p>This principle calls for a fundamentally different design posture: not the city as machine that is managed, but as garden that is tended. The work is creating conditions, removing blockages, building structures that make self-organization possible. And then: giving space.</p>"},business:{activating:"Build for natural self-organization",short:"Build organizations where teams and ecosystems can self-organize, adapt, and recover. Not the organization as machine but as garden. Create conditions, remove blockages, give space.",full:"<p>Build organizations where teams, partnerships, and ecosystems can self-organize, adapt, and repair themselves. Stimulate diversity (in people, skills, perspectives, and approaches), functional redundancy (in roles and capabilities), and decentralized connected networks so that organizations can absorb shocks, become resilient, and adapt without centralized control. Continuous change becomes a source of improvement rather than threat.</p><p>Self-organization is primarily an ecological principle: natural processes are given space and freedom, in dynamic balance. Regenerative organizations trust in their own self-regulating capacity, intervening as little as necessary. When intervention becomes necessary, it proceeds from a cyclical process of observing, evaluating, and adjusting. But self-organization also has an organizational dimension: teams that self-organize, communities of practice that form organically, ecosystems of partners that find their own balance.</p><p>This principle calls for a fundamentally different organizational posture: not the organization as machine that is managed, but as garden that is tended. The work is creating conditions, removing blockages, building structures that make self-organization possible. And then: giving space.</p>"},products:{activating:"Design for user and ecosystem self-organization",short:"Design products that enable users and ecosystems to self-organize, adapt, and repair. Create conditions for agency — modular, repairable, open.",full:"<p>Design products that enable users, communities, and ecosystems to self-organize, adapt, and repair themselves. Stimulate diversity (in configurations, repair possibilities, use contexts), functional redundancy (so products remain useful when parts fail), and open architectures so that products can evolve, be adapted, and recover rather than be discarded. Continuous change in use and context becomes a source of design richness rather than a problem.</p><p>Self-organization is primarily an ecological principle: natural processes are given space in dynamic balance. Regenerative product design trusts in the adaptive capacity of users and materials — designing for repair, modification, and unexpected use rather than controlling outcomes through engineered obsolescence. When redesign is needed, it proceeds from a cyclical process of observing use, evaluating performance, and adjusting form.</p><p>This principle calls for a fundamentally different design posture: not the product as machine that fixes user behavior, but as tool that empowers it. The work is creating conditions — through modularity, repairability, open documentation, and shared knowledge — that make self-organization possible. And then: giving space.</p>"}},
  5:{cities:{activating:"Be attentive to all life",short:"Design with explicit attention to the coexistence of all life forms. Nature as actor, not service provider. Both ecological and social inclusion are essential.",full:"<p>Design with explicit attention to the coexistence of all life forms: people, plants, animals, and microbiomes receive space, connection, and protection in the design. This principle recognizes nature not as decoration or service provider, but as actor with its own interests equally weighed in design and management.</p><p>This principle has two inseparable dimensions. The ecological dimension requires treating nature as co-designer: habitats are integrated, corridors connected, non-human species given space to function and flourish. The social dimension requires actively including all human groups, including vulnerable groups for whom barriers to participation are explicitly removed.</p><p>Both dimensions are equally essential. A design that recognizes nature as stakeholder but excludes certain population groups is not regenerative. Equally, a design that is socially inclusive but ignores the non-human world is not regenerative. Regenerative design calls for equitable engagement with all life.</p>"},business:{activating:"Create value for all life",short:"Create value with explicit attention to all stakeholders: employees, communities, ecosystems, and non-human life. Nature as co-beneficiary, not resource or risk. Both ecological and social inclusion are essential.",full:"<p>Create value with explicit attention to all stakeholders: employees, customers, supply chain communities, local ecosystems, and non-human life. This principle recognizes nature not as a resource to be managed or a risk to be mitigated, but as a co-beneficiary whose interests are equally weighed in business decisions and strategy.</p><p>This principle has two inseparable dimensions. The ecological dimension requires treating nature as a stakeholder: ecosystems are supported, supply chain biodiversity is maintained and built, and non-human species receive consideration in operational and strategic decisions. The social dimension requires actively involving all human stakeholders — including those with the least power in the system — with barriers to participation explicitly removed.</p><p>Both dimensions are equally essential. A business that recognizes nature as a stakeholder but exploits its workers is not regenerative. Equally, a business that is socially inclusive but depletes the ecosystems it depends on is not regenerative. Regenerative business calls for equitable engagement with all life — and makes that engagement structural, not incidental.</p>"},products:{activating:"Design for all life across the full lifecycle",short:"Design with explicit attention to all life touched by the product: users, makers, ecosystems, and non-human life. Both ecological and social inclusion are essential across the full lifecycle.",full:"<p>Design with explicit attention to the full community of life touched by a product: the users who interact with it, the makers who produce it, the communities that live near production sites, the ecosystems whose materials it draws from, and the non-human life affected across its lifecycle. This principle recognizes nature not as a background material source or waste destination, but as a community of actors whose interests are equally weighed in design decisions.</p><p>This principle has two inseparable dimensions. The ecological dimension requires treating nature as a co-designer: materials are sourced from living systems that are supported rather than depleted, production processes are benign to surrounding ecosystems, and end-of-life design keeps materials in biological or technical cycles. The social dimension requires actively including all human groups in design — users across ages, abilities, and economic contexts — with barriers to equitable access explicitly addressed, and makers given fair and dignified conditions.</p><p>Both dimensions are equally essential. A product with ecological care but exploitative labor is not regenerative. Equally, a product that is socially inclusive but draws on ecologically destructive materials is not regenerative. Regenerative product design calls for equitable attention to all life across the full lifecycle.</p>"}},
  6:{cities:{activating:"Design for future generations",short:"Design with an explicit long-term orientation. Short-term gain must not undermine long-term viability. Design for adaptability, not just durability.",full:"<p>Design with an explicit long-term orientation that considers the consequences of every decision for future generations. By designing with a time horizon of decades to centuries, you ensure that soil quality, biodiversity, and social structures not only flourish today but remain resilient over many generations. Short-term gain must not undermine long-term viability.</p><p>This principle anchors a stewardship ethic in design choices: it is not only about what we need now, but about what future generations will need. That calls for humility about what we can know today. Future generations will have different needs than we do. Designing for the long term therefore also means designing for adaptability and flexibility, not only for durability. A temporary building consciously designed to make way for something better can be as strong an expression of intergenerational thinking as a centuries-old structure.</p>"},business:{activating:"Build for future generations",short:"Build with an explicit long-term orientation. Short-term profit must not undermine long-term viability. Design for ownership structures and adaptive capacity — not just current performance.",full:"<p>Build with an explicit long-term orientation that considers the consequences of every decision for future generations. By building with a time horizon of decades to generations, you ensure that the organizational, ecological, and social structures you create not only flourish today but remain resilient over many generations. Short-term profit must not undermine long-term viability.</p><p>This principle anchors a stewardship ethic in business decisions: it is not only about what we need now, but about what future stakeholders will need. That calls for humility about what we can know today. Future generations will have different needs than current ones. Building for the long term therefore means designing for ownership structures that protect purpose and for adaptive organizational capacity, not just current financial performance. A business model deliberately designed to evolve toward something better — anchored by steward ownership, purpose locks, and patient capital — can be as strong an expression of intergenerational thinking as a centuries-old institution.</p>"},products:{activating:"Design for future generations and material return",short:"Design with a time horizon extending beyond the current product cycle. Do not undermine long-term material health for short-term performance. Design for longevity, repairability, and material return — not for obsolescence.",full:"<p>Design with an explicit long-term orientation that considers the consequences of every material choice and design decision for future generations. By designing with a time horizon extending well beyond the current product cycle, you ensure that the materials you draw from, the processes you set in motion, and the use cultures you create not only function today but remain viable across many lifetimes. Short-term market performance must not undermine long-term material health.</p><p>This principle anchors a stewardship ethic in design choices: it is not only about what users need now, but about what future users, communities, and ecosystems will need. That calls for humility about what we can predict. Future use contexts will differ from current ones. Designing for the long term therefore means designing for longevity, repairability, and material return — not just initial performance. A product deliberately designed to be repaired, upgraded, and returned to material cycles can be as strong an expression of intergenerational thinking as one built to last a century unchanged.</p>"}},
  7:{cities:{activating:"Build new regenerative cultures",short:"Design aimed at strengthening and renewing socio-cultural webs: care, trust, reciprocity, and shared ownership through connection.",full:"<p>Design aimed at strengthening and renewing socio-cultural webs: care, trust, reciprocity, and shared ownership through connection. This principle recognizes that regenerative change is fundamentally cultural change. Technical and ecological interventions only have lasting impact if they are rooted in a different way of living, of ownership, of relating to place and community.</p><p>Communities that see themselves as responsible for their living environment — that manage together, decide together, care together — are the carriers of regenerative transition. Shared ownership, co-creation, and local initiatives are not byproducts but core challenges. A regenerative culture cannot be a cultural elite: the paradigm shift must bridge to broad social layers, not remain an island for a small group of like-minded people.</p><p>This is of all eight principles the most demanding. It asks not only for different methods but a different basic posture toward ownership, control, and growth. That is exactly why building new regenerative cultures is not a final chapter of design but its starting point.</p>"},business:{activating:"Build new regenerative organizational cultures",short:"Build aimed at strengthening and renewing organizational and community culture: care, trust, reciprocity, and shared ownership through connection. Regenerative business change is fundamentally cultural change.",full:"<p>Build aimed at strengthening and renewing organizational and community cultures: care, trust, reciprocity, and shared ownership through connection. This principle recognizes that regenerative change in business is fundamentally cultural change. Strategic and operational interventions only have lasting impact if they are rooted in a different way of working, of owning, and of relating to the purpose of the organization.</p><p>Organizations that see themselves as responsible for the health of their communities and ecosystems — that co-create, share stewardship, and care together — are the carriers of regenerative business transition. Shared ownership, co-creation with stakeholders, and locally rooted initiatives are not byproducts but core challenges. A regenerative organizational culture cannot be a leadership elite: the paradigm shift must bridge to all layers of the organization and communities it affects, not remain an island for a committed few.</p><p>This is of all eight principles the most demanding for business. It asks not only for different strategies but a different basic posture toward ownership, control, and growth — releasing patterns deeply embedded in how organizations are structured and how people understand themselves as professionals. That is exactly why building new regenerative cultures is not a final chapter of business transformation but its starting point.</p>"},products:{activating:"Design products that carry and build regenerative culture",short:"Design aimed at products that carry and strengthen regenerative culture: care, repair, reciprocity, and shared meaning. Products are cultural artifacts.",full:"<p>Design aimed at products that carry and build regenerative culture: care, repair, reciprocity, and shared meaning. This principle recognizes that products are cultural artifacts — not neutral objects but active participants in the cultures that make and use them. They communicate values, enable or disable practices, and strengthen or weaken the relationships between people, communities, and living systems. Regenerative change in material culture is fundamentally cultural change.</p><p>Products that invite repair rather than replacement, that carry the marks of use with dignity, that connect users to the communities and ecosystems they come from — these are the cultural carriers of regenerative transition. Design for care, maintenance, skill, and attachment is not a design constraint but a core challenge. A regenerative material culture cannot be a premium niche: the shift in values must be embedded in everyday objects accessible to broad populations, not confined to high-end exceptions.</p><p>This is of all eight principles the most transformative for product design. It asks not only for different materials and processes but a different basic posture toward what products are for — releasing patterns deeply embedded in consumer culture: the expectation of novelty, the devaluing of repair, the severance between products and their origins. That is exactly why designing for regenerative culture is not a finishing touch on a product strategy but its first principle.</p>"}},
  8:{cities:{activating:"Govern as a community",short:"Design governance structures, decision-making, and ownership models that enable long-term care and collective stewardship.",full:"<p>Design governance structures, decision-making, and ownership models that enable long-term care and collective stewardship. Technical and ecological interventions that are not supported by suitable institutional frameworks quickly lose their regenerative effect. Well-designed governance is therefore not a precondition but an integral part of the design itself.</p><p>Choose where possible for commons models, cooperatives, or steward-ownership structures that ensure that management, access, and value creation benefit the community and the ecosystem. Commons forms strengthen transparency, engagement, and continuity, ensuring that public and semi-public infrastructure is not eroded or privatized at the expense of ecological and social goals.</p><p>Governance must also evolve. Adaptive governance — that works learning and evaluatively, offering space for adjustment without losing long-term goals — is a core quality of regenerative stewardship. In this way resilient networks emerge in which users co-determine, co-bear, and co-benefit, and in which care for a place can be passed across generations.</p>"},business:{activating:"Govern as a community of purpose",short:"Design governance structures, ownership models, and decision-making that enable long-term care, collective stewardship, and the protection of regenerative purpose from extraction.",full:"<p>Design governance structures, ownership models, and decision-making processes that enable long-term care, collective stewardship, and the protection of regenerative purpose from extraction. Strategic and operational decisions not supported by appropriate institutional structures lose their regenerative effect quickly. Well-designed governance is therefore not a precondition but an integral part of the business design itself.</p><p>Choose where possible for steward-ownership models, cooperatives, or purpose-lock structures that ensure that management, access, and value creation benefit the community, ecosystems, and the mission — rather than external shareholders optimizing for financial return. These structures strengthen transparency, commitment, and continuity, ensuring that business value is not redirected away from ecological and social goals by short-term ownership pressures.</p><p>Governance must also evolve. Adaptive governance — learning and evaluative, offering space for adjustment without losing long-term purpose — is a core quality of regenerative business stewardship. In this way resilient networks emerge in which all stakeholders co-determine, co-bear, and co-benefit, and in which care for a purpose can be passed across generations.</p>"},products:{activating:"Open your design as a commons",short:"Design products, platforms, and intellectual property as a commons where possible. Enable collective care, repair, adaptation, and stewardship across the product's lifecycle.",full:"<p>Design products, platforms, and intellectual property as a commons where possible. Enable collective care, repair, adaptation, and stewardship across the product's lifecycle. Technical and ecological design choices not supported by appropriate access and ownership structures quickly lose their regenerative effect: when repair knowledge is proprietary, when materials cannot be safely identified and recovered, when communities cannot adapt products to their needs.</p><p>Choose where possible for open design, right-to-repair architectures, shared material libraries, or commons-based platforms that ensure management, access, and value creation benefit users, makers, and ecosystems — rather than concentrating value in ways that undermine regenerative use. Open structures strengthen community engagement, transparency, and continuity, ensuring that product value is not captured away from ecological and social goals by restrictive IP or engineered lock-in.</p><p>Product governance must also evolve. Adaptive stewardship — learning and evaluative, offering communities space for adjustment without losing regenerative design integrity — is a core quality of regenerative product development. In this way resilient networks of makers, users, and repair communities emerge in which the care for a design can be passed across generations.</p>"}}
};

type PxDomainKey = 'cities' | 'business' | 'products';
type PxPrincipleKey = 1|2|3|4|5|6|7|8;
interface PxEntry { activating: string; short: string; full: string; }

let pxState: {domain: PxDomainKey; principle: PxPrincipleKey} = {domain:'cities',principle:1};

function pxSelectDomain(d: string) {
  pxState.domain = d as PxDomainKey;
  document.querySelectorAll('.px-domain-tab').forEach(t => (t as HTMLElement).classList.toggle('active', (t as HTMLElement).dataset.domain === d));
  pxRender();
}
function pxSelectPrinciple(p: number) {
  pxState.principle = p as PxPrincipleKey;
  document.querySelectorAll('.px-pcard').forEach(c => (c as HTMLElement).classList.toggle('active', +(c as HTMLElement).dataset.p! === p));
  pxRender();
  document.getElementById('px-detail')!.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function pxNavigate(delta: number) {
  const next = pxState.principle + delta;
  if (next < 1 || next > 8) return;
  pxSelectPrinciple(next);
}
function pxRender() {
  const {domain, principle} = pxState;
  const data = (PX_DATA as Record<number, Record<string, PxEntry>>)[principle][domain];
  const num = String(principle).padStart(2,'0');
  const strip = document.getElementById('px-detail-strip')!;
  strip.className = 'h-[5px] bg-green ' + (domain === 'cities' ? '' : domain);
  document.getElementById('px-detail-num')!.textContent = num;
  document.getElementById('px-detail-title')!.textContent = PX_NAMES[principle-1];
  document.getElementById('px-detail-activating')!.textContent = data.activating;
  document.getElementById('px-detail-short')!.textContent = data.short;
  document.getElementById('px-detail-body')!.innerHTML = data.full;
  document.getElementById('px-nav-progress')!.textContent = principle + ' / 8';
  (document.getElementById('px-nav-prev') as HTMLButtonElement).disabled = principle === 1;
  (document.getElementById('px-nav-next') as HTMLButtonElement).disabled = principle === 8;
  document.getElementById('px-detail')!.classList.add('visible');
}

document.querySelectorAll('.px-domain-tab').forEach(btn => {
  btn.addEventListener('click', () => pxSelectDomain((btn as HTMLElement).dataset.domain!));
});
document.querySelectorAll('.px-pcard').forEach(btn => {
  btn.addEventListener('click', () => pxSelectPrinciple(+(btn as HTMLElement).dataset.p!));
});
</script>
