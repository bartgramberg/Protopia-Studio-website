---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { t } from '../i18n/translations'
const locale = 'nl'
const tr = t(locale)
---
<Base title="Waarom Regeneratie" description="De grote uitdagingen van onze tijd vragen om meer dan het beperken van schade. Ze vragen om actief herstel." locale={locale} altHref="/en/why">
  <Nav locale={locale} altHref="/en/why" activePage="waarom" />

  <!-- Hero -->
  <div class="page-hero bg-creme pt-16 sm:pt-20 lg:pt-[88px] pb-12 sm:pb-14 lg:pb-16">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">Waarom Regeneratie</span>
      <h1 class="text-[clamp(32px,9vw,58px)] font-bold leading-[1.1] tracking-[-0.025em] text-green text-balance mb-5">Waarom regeneratie?</h1>
      <p class="text-[16px] sm:text-[18px] text-mid leading-[1.75] max-w-[680px]">De grote uitdagingen van onze tijd vragen om meer dan het beperken van schade. Ze vragen om actief herstel — van ecosystemen, van gemeenschappen, van de balans tussen mens en natuur. Niet wachten op de perfecte oplossing, maar nu de beste stap zetten die mogelijk is. Dat is regeneratie.</p>
    </div>
  </div>

  <!-- Spectrum -->
  <section class="py-14 sm:py-16 lg:py-20">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">Het spectrum</span>
      <h2 class="text-[clamp(28px,3.5vw,42px)] font-bold leading-[1.15] tracking-[-0.02em] text-green text-balance">Degeneratief. Duurzaam. Regeneratief.</h2>
      <div class="grid gap-5 md:grid-cols-3 mt-10">
        <div class="bg-white border border-[rgba(72,115,91,0.15)] rounded-lg p-8 shadow-[0_2px_8px_rgba(26,26,26,0.04)]">
          <img src="/assets/spectrum/degeneratief.png" alt="Degeneratief—vervuilde stad illustratie" class="w-full aspect-[5/4] object-contain mb-4" />
          <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-light mb-2.5">Stap 1</div>
          <div class="text-[20px] font-bold text-green mb-2.5">Degeneratief</div>
          <p class="text-[14px] text-mid leading-[1.7]">Onze huidige manier van leven heeft een onomkeerbare impact op de wereld. Dit degeneratieve systeem — extractief, lineair, gebaseerd op schaarste en uitputten van natuurlijke bronnen — is niet houdbaar.</p>
        </div>
        <div class="bg-white border border-[rgba(72,115,91,0.15)] rounded-lg p-8 shadow-[0_2px_8px_rgba(26,26,26,0.04)]">
          <img src="/assets/spectrum/sustainable.png" alt="Duurzaam—stad in balans illustratie" class="w-full aspect-[5/4] object-contain mb-4" />
          <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-light mb-2.5">Stap 2</div>
          <div class="text-[20px] font-bold text-green mb-2.5">Duurzaam</div>
          <p class="text-[14px] text-mid leading-[1.7]">Gelukkig zijn we ons hier collectief steeds meer van bewust, en heeft duurzaamheidsdenken de afgelopen decennia een vlucht genomen. Duurzaamheid is een noodzakelijke, maar uiteindelijk onvolmaakte positie. Schade beperken en in stand houden van de status quo is niet genoeg.</p>
        </div>
        <div class="bg-white border border-[rgba(72,115,91,0.15)] rounded-lg p-8 shadow-[0_2px_8px_rgba(26,26,26,0.04)]">
          <img src="/assets/spectrum/regeneratief.png" alt="Regeneratief—groene stad illustratie" class="w-full aspect-[5/4] object-contain mb-4" />
          <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-light mb-2.5">Stap 3 — de richting</div>
          <div class="text-[20px] font-bold text-magenta mb-2.5">Regeneratief</div>
          <p class="text-[14px] text-mid leading-[1.7]">De volgende stap is regeneratie: het actief herstellen van natuurlijke en sociale ecosystemen. Een systemische kijk op de wereld die uitgaat van overvloed, wederkerigheid en veerkracht, waarbij het doel is meer terug te geven dan je neemt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Vier toepassingsgebieden -->
  <section class="py-14 sm:py-16 lg:py-20 bg-creme">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">Vier toepassingsgebieden</span>
      <h2 class="text-[clamp(28px,3.5vw,42px)] font-bold leading-[1.15] tracking-[-0.02em] text-green text-balance">Geen utopie, maar concrete stappen.</h2>
      <div class="grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-14 items-start mt-10">
        <div class="flex flex-col gap-3.5">
          <p class="text-[16px] text-mid leading-[1.7]">Regeneratie is geen abstracte belofte. Het is de richting die je kiest met elk project, elke ingreep, elke beslissing — of het nu gaat om een stad, een bedrijf of een product.</p>
          <p class="text-[16px] text-mid leading-[1.7]">Protopia werkt in het spanningsveld tussen regeneratieve visie en economische realiteit, en maakt dat spanningsveld productief.</p>
          <p class="text-[16px] text-mid leading-[1.7]">Niet door te adviseren vanaf de zijlijn, maar door te ontwerpen, te bouwen en te realiseren.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="bg-white border border-[rgba(72,115,91,0.18)] rounded-lg p-5 flex flex-col justify-center min-h-[110px]">
            <div class="text-[14px] font-bold text-green mb-1">Omgevingen</div>
            <div class="text-[12.5px] text-mid leading-[1.55]">Levende socio-ecologische systemen die meer teruggeven dan ze nemen.</div>
          </div>
          <div class="bg-white border border-[rgba(72,115,91,0.18)] rounded-lg p-5 flex flex-col justify-center min-h-[110px]">
            <div class="text-[14px] font-bold text-green mb-1">Bedrijven</div>
            <div class="text-[12.5px] text-mid leading-[1.55]">Businessmodellen die ecologische en sociale waarde creëren naast financiële.</div>
          </div>
          <div class="bg-white border border-[rgba(72,115,91,0.18)] rounded-lg p-5 flex flex-col justify-center min-h-[110px]">
            <div class="text-[14px] font-bold text-green mb-1">Producten</div>
            <div class="text-[12.5px] text-mid leading-[1.55]">Ontwerpen die de levende systemen versterken waarvan ze afhankelijk zijn.</div>
          </div>
          <div class="bg-green rounded-lg p-5 flex flex-col justify-center min-h-[110px]">
            <div class="text-[9.5px] font-semibold uppercase tracking-[0.14em] text-white/70 mb-1.5">Onze Rol</div>
            <div class="text-[15px] font-bold text-white mb-1.5">Van visie naar prototype naar realisatie.</div>
            <div class="text-[12.5px] text-white/90 leading-[1.6]">Wij bouwen wat er anders niet was geweest.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 Principes -->
  <section class="py-14 sm:py-16 lg:py-20">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-green pb-2 border-b-2 border-green inline-block mb-5">8 regeneratieve principes als kompas</span>
      <h2 class="text-[clamp(28px,3.5vw,42px)] font-bold leading-[1.15] tracking-[-0.02em] text-green text-balance">Ontdek onze acht principes.</h2>
      <p class="text-[16px] sm:text-[17px] text-mid leading-[1.75] max-w-[680px] mt-4">Protopia Studio heeft acht regeneratieve ontwerpprincipes ontwikkeld. Ze beschrijven geen eindtoestand, maar een richting — van meer leven, meer overvloed, en meer vermogen van systemen om zichzelf te vernieuwen. Deze principes zijn tegelijk een ontwerphouding en een toetsinstrument: voor steden, voor organisaties, voor producten.</p>

      <div class="mt-8">
        <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-light mb-4">Kies een principe</div>
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4" id="principles-grid">
          {[
            { num: '01', p: 1, title: 'Ontwerp vanuit één levend systeem', desc: 'Ontwerp vanuit één geïntegreerd socio-ecologisch geheel.', img: '/assets/principes/01-holistic.png' },
            { num: '02', p: 2, title: 'Geef meer terug dan je neemt',  desc: 'Geef per saldo meer terug dan je neemt.',                    img: '/assets/principes/02-resources.png' },
            { num: '03', p: 3, title: 'Beweeg mee met natuurlijke en culturele ritmes', desc: 'Beweeg mee met cycli, seizoenen en timing.', img: '/assets/principes/03-cycli.png' },
            { num: '04', p: 4, title: 'Ontwerp voor natuurlijke zelforganisatie', desc: 'Creëer condities — geef ruimte, geen sturing.',   img: '/assets/principes/04-resilience.png' },
            { num: '05', p: 5, title: 'Heb aandacht voor al het leven', desc: 'Heb gelijkwaardig aandacht voor mens én niet-menselijk leven.', img: '/assets/principes/05-inclusief.png' },
            { num: '06', p: 6, title: 'Ontwerp voor toekomstige generaties', desc: 'Ontwerp voor toekomstige generaties.',                img: '/assets/principes/06-intergenerationeel.png' },
            { num: '07', p: 7, title: 'Versterk regeneratieve cultuur', desc: 'Versterk de cultuur die regeneratie draagt.',               img: '/assets/principes/07-social.png' },
            { num: '08', p: 8, title: 'Bestuur als gemeenschap',       desc: 'Bouw aan gedeeld bezit en gezamenlijk rentmeesterschap.',    img: '/assets/principes/08-commons.png' },
          ].map(item => (
            <button
              class="px-pcard text-left border border-[rgba(72,115,91,0.12)] bg-creme rounded-lg overflow-hidden transition-all duration-200 hover:border-green hover:shadow-[0_6px_20px_rgba(72,115,91,0.12)] hover:-translate-y-0.5"
              data-p={item.p}
            >
              <div class="px-card-img">
                <img src={item.img} alt={item.title} />
              </div>
              <div class="px-3 py-3 sm:px-3.5 sm:py-3.5">
                <div class="text-[21px] font-extrabold text-magenta leading-none mb-1.5">{item.num}</div>
                <div class="text-[13px] font-bold text-green leading-snug mb-1">{item.title}</div>
                <p class="text-[11px] text-mid leading-[1.45]">{item.desc}</p>
              </div>
            </button>
          ))}
        </div>

        <!-- Detail panel -->
        <div id="px-detail" class="mt-7 bg-creme rounded-xl overflow-hidden opacity-0 translate-y-2 transition-all duration-300">
          <div id="px-detail-strip" class="h-[5px] bg-green"></div>
          <div class="p-5 sm:p-8 relative">
            <div id="px-detail-num" class="absolute top-[18px] right-5 sm:right-7 text-[44px] sm:text-[64px] font-light italic text-green/20 leading-none tracking-[-2px]">01</div>
            <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-light mb-2.5">Kies een domein</div>
            <div class="flex gap-2 flex-wrap mb-5 pr-16 sm:pr-24" id="domain-tabs">
              <button class="px-domain-tab active" data-domain="cities">Omgevingen</button>
              <button class="px-domain-tab" data-domain="business">Bedrijven</button>
              <button class="px-domain-tab" data-domain="products">Producten</button>
            </div>
            <h3 id="px-detail-title" class="text-[20px] sm:text-[22px] font-bold text-green mb-1.5 leading-snug max-w-[82%] sm:max-w-[78%]">Ontwerp vanuit één levend systeem</h3>
            <p id="px-detail-activating" class="text-[13px] italic text-magenta mb-3.5"></p>
            <div id="px-detail-short" class="text-[13px] text-mid leading-[1.7] p-4 bg-white rounded-lg mb-4"></div>
            <div id="px-detail-body" class="text-[13.5px] text-[#333] leading-[1.8]"></div>
            <div class="flex flex-wrap justify-between items-center gap-3 mt-5 pt-4 border-t border-[rgba(72,115,91,0.12)]">
              <button id="px-nav-prev" class="px-nav-btn">← Vorige</button>
              <span id="px-nav-progress" class="text-[11px] text-light tracking-[0.1em]">1 / 8</span>
              <button id="px-nav-next" class="px-nav-btn">Volgende →</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <div class="bg-green py-14 sm:py-16 lg:py-[72px] text-center">
    <div class="max-w-content mx-auto px-5 sm:px-8 lg:px-10">
      <h2 class="text-[clamp(26px,3vw,38px)] font-bold text-white leading-[1.2] mb-2.5 text-balance">Regeneratieve kennis in de praktijk</h2>
      <p class="text-[16px] text-white/70 mb-7 max-w-[820px] mx-auto leading-[1.7]">Regeneratieve theorie krijgt pas kracht als ze geworteld is in de praktijk. Daarom bouwen wij actief aan een kennisbasis van regeneratieve initiatieven en aanpakken wereldwijd. Die database vormt de ruggengraat van ons werk — zodat we voor elk vraagstuk kunnen putten uit wat er al werkt, en dat vertalen naar de context van onze opdrachtgevers. Zie ook ons verkennend onderzoek Amsterdam Regeneratieve Stad.</p>
      <div class="flex gap-3.5 justify-center flex-wrap">
        <a href="/projecten" class="inline-flex items-center gap-1.5 px-[26px] py-[11px] rounded-pill text-[14px] font-semibold text-white border border-white/50 hover:bg-white/10 transition-colors">Bekijk projecten</a>
        <a href="/contact" class="inline-flex items-center gap-1.5 px-[26px] py-[11px] rounded-pill text-[14px] font-semibold text-white border border-white/50 hover:bg-white/10 transition-colors">Neem contact op</a>
      </div>
    </div>
  </div>

  <Footer locale={locale} />
</Base>

<style>
.px-domain-tab {
  cursor: pointer;
  border: 1px solid var(--color-border, #DEDAD4);
  background: white;
  color: #4A4A4A;
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
  padding: 9px 22px;
  border-radius: 999px;
  transition: all 0.15s;
}
.px-domain-tab:hover { background: #F2EFE9; color: #48735B; }
.px-domain-tab.active { color: white; }
.px-domain-tab[data-domain="cities"].active { background: #48735B; border-color: #48735B; }
.px-domain-tab[data-domain="business"].active { background: #347EBF; border-color: #347EBF; }
.px-domain-tab[data-domain="products"].active { background: #D90D7D; border-color: #D90D7D; }
.px-card-img {
  height: 118px;
  overflow: hidden;
  background: #F2EFE9;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
}
.px-card-img img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
}
@media (min-width: 640px) {
  .px-card-img { height: 150px; }
}
@media (min-width: 1024px) {
  .px-card-img { height: 170px; }
}
.px-pcard.active { border-color: #D90D7D !important; box-shadow: 0 6px 20px rgba(217,13,125,0.18) !important; }
.px-pcard.active .principle-title { color: #D90D7D; }
#px-detail.visible { opacity: 1 !important; transform: translateY(0) !important; }
#px-detail:not(.visible) { display: none; }
#px-detail-body :global(p) { margin: 0; }
#px-detail-body :global(p + p) { margin-top: 1.2rem; }
#px-detail-strip.business { background: #347EBF; }
#px-detail-strip.products { background: #D90D7D; }
.px-nav-btn {
  cursor: pointer;
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  color: #48735B;
  background: white;
  border: 1px solid #DEDAD4;
  padding: 7px 16px;
  border-radius: 999px;
  transition: all 0.15s;
}
.px-nav-btn:hover { background: #48735B; color: white; border-color: #48735B; }
.px-nav-btn:disabled { opacity: 0.4; cursor: default; background: white; color: #7A7A7A; }
</style>

<script>
const PX_NAMES = ['Ontwerp vanuit één levend systeem','Geef meer terug dan je neemt','Beweeg mee met natuurlijke en culturele ritmes','Ontwerp voor natuurlijke zelforganisatie','Heb aandacht voor al het leven','Ontwerp voor toekomstige generaties','Versterk regeneratieve cultuur','Bestuur als gemeenschap'];
const PX_DATA = {
  1:{cities:{activating:"Ontwerp vanuit het idee van één levend socio-ecologisch systeem",short:"Ontwerp vanuit het besef dat de stad één geïntegreerd, voortdurend veranderend socio-ecologisch systeem is, ingebed in een grotere bioregionale context.",full:"<p>Een stad is een levend socio-ecologisch systeem: een voortdurend veranderend geheel waarin ecologie, sociale en culturele structuren, en economie onlosmakelijk met elkaar verweven zijn. Die drie dimensies versterken of ondermijnen elkaar voortdurend. Regeneratief ontwerpen begint met het erkennen van die wederkerigheid, en met het ontwerpen van oplossingen die meerdere functies tegelijk dienen.</p><p>De stad is nooit een gesloten systeem. Ze is onderdeel van een groter geheel: de buurt is onderdeel van de stad, de stad van de regio, de regio van een breder landschap. Elk schaalniveau is tegelijk een autonome eenheid en onderdeel van een groter geheel. Een ingreep in een buurt werkt door op het niveau van stad en regio. En omgekeerd bepaalt wat op regionaal niveau gebeurt wat op buurtniveau mogelijk is. Het actief verbinden van schaalniveaus is een kernopgave van regeneratief ontwerpen.</p><p>Interventies worden niet beoordeeld op één enkel doel, maar op hun bijdrage aan het geheel. Denk aan regenwaterbeheer dat tegelijk biodiversiteit, speelruimte en sociale ontmoeting versterkt. Of aan een voedselprogramma dat tegelijk bodemkwaliteit, sociale cohesie en lokale economie opbouwt.</p>"},business:{activating:"Handel vanuit het idee van één levend socio-ecologisch systeem",short:"Handel vanuit het besef dat de organisatie één geïntegreerd, voortdurend veranderend socio-ecologisch systeem is, ingebed in de levende context van waardeketens, gemeenschappen en bioregio's.",full:"<p>Een organisatie is een levend socio-ecologisch systeem: een voortdurend veranderend geheel waarin ecologie, sociale en culturele structuren, en economie onlosmakelijk met elkaar verweven zijn. Die drie dimensies versterken of ondermijnen elkaar voortdurend. Regeneratief ondernemen begint met het erkennen van die wederkerigheid, en met het nemen van beslissingen die meerdere waardedimensies tegelijk dienen.</p><p>Een organisatie is nooit een gesloten systeem. Ze is onderdeel van een groter geheel: het team is onderdeel van de organisatie, de organisatie van de toeleveringsketen en sector, de sector van de bioregio. Elk schaalniveau is tegelijk autonoom en onderdeel van een groter geheel. Een beslissing in een team werkt door naar de keten en de gemeenschap. En omgekeerd vormt wat op bioregionaal niveau gebeurt wat op organisatieniveau mogelijk is. Het actief verbinden van deze schaalniveaus is een kernopgave van regeneratief ondernemen.</p><p>Bedrijfsbeslissingen worden niet alleen beoordeeld op financieel rendement, maar op hun bijdrage aan het levende geheel. Denk aan een wervingspraktijk die tegelijk organisatiecapaciteit opbouwt, relaties met de gemeenschap versterkt en ecologische kansen creëert. Of aan een inkoopbeslissing die tegelijk bodemgezondheid, lokale economische veerkracht en langetermijnzekerheid van materialen opbouwt.</p>"},products:{activating:"Ontwerp vanuit het idee van één levend systeem — van materiaal tot einde levensduur",short:"Ontwerp vanuit het besef dat een product bestaat binnen één geïntegreerd, voortdurend veranderend socio-ecologisch systeem — van materiaaloorsprong via gebruik tot einde levensduur — en dat elke ontwerpbeslissing dit grotere geheel beïnvloedt.",full:"<p>Een product is geen geïsoleerd artefact, maar onderdeel van een levend socio-ecologisch systeem: een voortdurend veranderend geheel waarin ecologie, sociale en culturele structuren, en economie in elke fase van zijn leven verweven zijn. Die drie dimensies versterken of ondermijnen elkaar over materiaaloorsprong, productie, gebruik en einde levensduur heen. Regeneratief productontwerp begint met het erkennen van die wederkerigheid, en met het ontwerpen van objecten die meerdere systemen tegelijk dienen.</p><p>Een product is nooit een gesloten systeem. Het is onderdeel van een groter geheel: het materiaal is onderdeel van het product, het product van het gebruiksecosysteem, het gebruiksecosysteem van de toeleveringsketen en bioregio. Elk schaalniveau is tegelijk autonoom en onderdeel van een groter geheel. Een materiaalkeuze werkt door naar het producerende ecosysteem, het gedrag van de gebruiker en het einde-levensduurlandschap. Het actief meenemen van deze schaalverbindingen — van vezel tot veld tot stortplaats — is een kernopgave van regeneratief productontwerp.</p><p>Producten worden niet alleen beoordeeld op functie of prijs, maar op hun bijdrage aan het levende geheel. Denk aan een materiaalkeuze die tegelijk bodemgezondheid ondersteunt, bestaanszekerheid biedt aan een landbouwgemeenschap en een mooi, duurzaam product oplevert. Of aan een verpakkingsontwerp dat biologische voedingsstoffen teruggeeft aan de bodem, gebruikers iets leert over natuurlijke systemen en regionale afvalinfrastructuurkosten elimineert.</p>"}},
  2:{cities:{activating:"Geef meer terug dan je neemt",short:"Ontwerp op basis van circulaire, lokale en hernieuwbare bronnen en stromen. Per saldo levert een interventie meer op dan ze kost.",full:"<p>Regeneratief grondstoffenbeheer gaat verder dan het sluiten van kringlopen. Het doel is een systeem dat netto meer toevoegt dan het verbruikt: dat bodemvruchtbaarheid opbouwt in plaats van uitput, biodiversiteit vergroot en sociale en economische waarde accumuleert. Niet alleen behouden, maar actief opbouwen.</p><p>Ontwerp op basis van circulaire, lokale en hernieuwbare stromen: hulpbronnen blijven in het systeem, worden actief opgebouwd en raken niet uitgeput. Dit omvat bodemopbouw, gesloten kringlopen voor water, energie, materialen en nutriënten, lokaal gebruik van reststromen en het minimaliseren van verlies.</p><p>Een regeneratieve stad streeft ernaar haar omgeving meer terug te geven dan ze neemt. Niet als absolute claim, maar als kompas en handelingsrichting. Die relatie is wederkerig: de stad voedt de regio, en de regio voedt de stad. Voedsel, water, materialen, ecologische diensten — ze stromen beide kanten op. Die wederkerigheid moet bewust worden ontworpen in voedselringen, herstelde watercycli en biobased materiaalproductie.</p>"},business:{activating:"Geef meer terug dan je neemt",short:"Opereer op basis van circulaire, regeneratieve stromen van natuurlijk, menselijk, sociaal en financieel kapitaal. Per saldo creëert een bedrijf meer over alle kapitalen heen dan het verbruikt.",full:"<p>Regeneratief grondstoffenbeheer in bedrijven gaat verder dan het verkleinen van de voetafdruk. Het doel is een organisatie die per saldo meer toevoegt dan ze verbruikt over alle kapitalen heen: die natuurlijk kapitaal opbouwt in plaats van uitput, menselijk floreren vergroot en sociale en economische waarde accumuleert. Niet alleen behouden, maar actief opbouwen.</p><p>Opereer op basis van circulaire, regeneratieve stromen over alle kapitalen heen: natuurlijk kapitaal (ecosystemen, materialen, water, bodem), menselijk kapitaal (gezondheid, vaardigheden en welzijn van mensen), sociaal kapitaal (vertrouwen, relaties, kenniscommons) en financieel kapitaal. Hulpbronnen blijven in systemen, worden actief opgebouwd en raken niet uitgeput. Dit omvat bodemgezondheid in ketens, gesloten kringlopen voor water, energie en materialen, lokaal gebruik van reststromen en het minimaliseren van verlies.</p><p>Een regeneratief bedrijf streeft ernaar zijn context meer terug te geven dan het neemt. Niet als absolute claim, maar als kompas en richting. Die relatie is wederkerig: de organisatie voedt de gemeenschappen waarin ze opereert, de ecosystemen waarvan ze afhankelijk is en de mensen die erin werken — en die gemeenschappen, ecosystemen en mensen voeden de organisatie op hun beurt. Die wederkerigheid moet bewust worden ontworpen in toeleveringsketens, waardeketens en governance-structuren — niet als CSR-toevoeging, maar als kernlogica van waardecreatie.</p>"},products:{activating:"Geef meer terug dan je neemt",short:"Ontwerp op basis van circulaire biologische en technische materiaalstromen. Per levenscyclus draagt een product meer bij aan levende systemen dan het onttrekt.",full:"<p>Regeneratief grondstoffenbeheer in productontwerp gaat verder dan het verminderen van materiaalvoetafdruk. Het doel is een product dat per levenscyclus meer toevoegt aan levende systemen dan het verbruikt: dat bodemgezondheid opbouwt in plaats van uitput, biodiversiteit ondersteunt en blijvende sociale en economische waarde creëert. Niet alleen schade minimaliseren, maar actief opbouwen.</p><p>Ontwerp op basis van circulaire materiaalstromen: elk materiaal hoort bij een biologische cyclus (veilige, goedaardige terugkeer naar bodem en levende systemen) of een technische cyclus (voortdurend hergebruik zonder kwaliteitsverlies). Materialen blijven in hun passende cyclus, worden actief op hun hoogste waarde gehouden en glijden niet af richting stortplaats. Dit omvat zorgvuldige materiaalkeuze, ontwerp voor demontage en retour, gebruik van regeneratief gewonnen grondstoffen en het elimineren van persistente toxische stoffen.</p><p>Een regeneratief product streeft ernaar de ecosystemen die het raakt meer terug te geven dan het neemt. Niet als absolute claim, maar als kompas en richting. Die relatie is wederkerig: het product put uit levende systemen en moet ontworpen zijn om waarde aan die systemen terug te geven — in biologische voedingsstoffen die bodem opbouwen, technische materialen die productief in gebruik blijven en culturele waarde die gemeenschappen en zorgpraktijken ondersteunt.</p>"}},
  3:{cities:{activating:"Beweeg mee met natuurlijke en sociaal-culturele ritmes en patronen",short:"Ontwerp in afstemming met natuurlijke en culturele patronen, cycli en timing.",full:"<p>Ontwerp in afstemming met natuurlijke en culturele patronen, cycli en timing: dag en nacht, seizoenen, groeifasen, herstelperioden. Respecteer natuurlijke tijdschalen en ontwikkel in het ritme van de natuur. Dit vraagt om geduld, timing en het loslaten van lineaire controle. Een toestand van voortdurende verandering wordt niet gezien als probleem, maar als vertrekpunt voor ontwerp.</p><p>De neiging om alles te willen beheersen en voorspellen zit diep in hoe we steden plannen en bouwen. Regeneratief ontwerpen vraagt om een andere houding: vertrouwen dat natuur en samenleving hun eigen balans vinden, en ruimte laten voor spontane ontwikkeling. Dat betekent niet passief toekijken. Als ontwerpers hebben we handelingsvermogen: we kunnen gerichte systeeminterventies doen die herstel versnellen. De kunst is het onderscheid tussen sturen en controleren.</p><p>Interventies worden afgestemd op natuurlijke en culturele processen: de timing van aanleg, plantenselectie volgens successie, seizoensgebonden activiteiten, de trage opbouw van bodem en gemeenschap. Zodat ontwerpen meebewegen met de eigen tempo's van mensen, natuur en landschap.</p>"},business:{activating:"Beweeg mee met natuurlijke, markt- en organisatieritmes en patronen",short:"Opereer in afstemming met natuurlijke, markt- en organisatiepatronen, cycli en timing. Continue verandering is een vertrekpunt, geen probleem dat gemanaged moet worden.",full:"<p>Opereer in afstemming met natuurlijke, markt- en organisatiepatronen, cycli en timing: seizoenen van groei en herstel, marktcycli, ontwikkelingsfasen van organisaties, innovatieritmes. Respecteer natuurlijke tijdschalen en ontwikkel in het ritme van de systemen waarin je opereert. Dit vraagt om geduld, timing en het loslaten van de aanname dat lineaire groei de natuurlijke staat is. Continue verandering is geen probleem om te managen, maar een vertrekpunt voor strategie.</p><p>De neiging om alles te controleren en voorspellen zit diep ingebed in hoe organisaties worden geleid. Regeneratief ondernemen vraagt om een andere houding: vertrouwen dat organisaties en markten hun eigen balans vinden, en ruimte creëren voor wat kan ontstaan. Dat betekent niet passief toekijken. Leiders hebben handelingsvermogen: gerichte systemische interventies kunnen positieve verandering versnellen. De kunst is het onderscheid tussen sturen en controleren.</p><p>Bedrijfsbeslissingen worden getimed met natuurlijke en organisatorische processen: het ritme van werving en onboarding, de seizoenen van financiering en oogst, de trage opbouw van vertrouwen en cultuur, de braakliggende periodes van organisatorisch herstel. Zodat strategieën meebewegen met de eigen tempo's van mensen, markten en ecosystemen — in plaats van ze te overschrijven met kunstmatige urgentie of geforceerde groei.</p>"},products:{activating:"Ontwerp met natuurlijke materiaallevenstijden en gebruiksritmes",short:"Ontwerp in afstemming met natuurlijke materiaallevenstijden, gebruikspatronen en culturele ritmes. Bouw voor veroudering en reparatie, niet voor geplande veroudering.",full:"<p>Ontwerp in afstemming met natuurlijke materiaallevenstijden, gebruikspatronen en culturele ritmes: het verouderen van hout en leer, de seizoensgebonden relevantie van bepaalde objecten, de onderhouds- en reparatiecycli van goed gemaakte dingen. Respecteer natuurlijke tijdschalen en ontwerp voor het ritme van materialen en gemeenschappen. Dit vraagt om geduld, timing en het afwijzen van geplande veroudering als ontwerpstrategie. Continue verandering in materialen en gebruik is geen probleem om te managen, maar een vertrekpunt voor ontwerp.</p><p>De neiging om alle verandering weg te ontwerpen — om producten permanent \"nieuw\" te houden via geplande vervangingscycli — zit diep ingebed in hoe producten worden ontwikkeld. Regeneratief productontwerp vraagt om een andere houding: vertrouwen dat materialen, gebruikers en ecosystemen hun eigen ritmes hebben, en ruimte creëren voor veroudering, aanpassing en successie. Dat betekent geen passief ontwerp. Ontwerpers hebben handelingsvermogen: ontwerpen voor reparatie, patina, modulariteit en materiaalterugkeer kan vormen hoe producten door de wereld bewegen. De kunst is het onderscheid tussen ontwerpen voor verandering en ontwerpen voor veroudering.</p><p>Producten worden ontworpen in afstemming met natuurlijke en culturele processen: materialen gewonnen op hun ecologische hoogtepunt, ontwerp voor opeenvolgende upgrades in plaats van volledige vervanging, onderhoud getimed op seizoenen of gebruiksdrempels, de trage opbouw van gebruikershechting en vaardigheid. Zodat producten meebewegen met de eigen ritmes van materialen, makers en gemeenschappen.</p>"}},
  4:{cities:{activating:"Ontwerp voor natuurlijke zelforganisatie",short:"Ontwerp plekken waar systemen zichzelf kunnen organiseren, aanpassen en herstellen. Schep condities, verwijder blokkades, geef ruimte.",full:"<p>Ontwerp plekken waar systemen zichzelf kunnen organiseren, aanpassen en herstellen. Stimuleer diversiteit, functionele redundantie en decentrale verbonden netwerken, zodat systemen schokken kunnen absorberen, veerkrachtig worden en zich kunnen aanpassen zonder centrale controle. Continue verandering wordt een bron van verbetering in plaats van bedreiging.</p><p>Zelforganisatie is primair een ecologisch principe: natuurlijke processen krijgen ruimte en vrijheid, in een dynamische balans. Er is vertrouwen in het zelfregulerende vermogen van de natuur, met zo weinig mogelijk menselijke interventie. Wanneer ingrijpen nodig wordt, gebeurt dat vanuit een cyclisch proces van observeren, evalueren en bijsturen. Maar zelforganisatie heeft ook een sociale dimensie: gemeenschappen die zichzelf organiseren, collectief rentmeesterschap opnemen en zich aanpassen aan verandering.</p><p>Dit principe vraagt om een fundamenteel andere ontwerphouding: niet de stad als machine die wordt beheerd, maar als tuin die wordt verzorgd. Het werk is condities scheppen, blokkades verwijderen, structuren bouwen die zelforganisatie mogelijk maken. En dan: ruimte geven.</p>"},business:{activating:"Bouw voor natuurlijke zelforganisatie",short:"Bouw organisaties waar teams en ecosystemen zichzelf kunnen organiseren, aanpassen en herstellen. Niet de organisatie als machine maar als tuin. Schep condities, verwijder blokkades, geef ruimte.",full:"<p>Bouw organisaties waar teams, partnerschappen en ecosystemen zichzelf kunnen organiseren, aanpassen en herstellen. Stimuleer diversiteit (in mensen, vaardigheden, perspectieven en benaderingen), functionele redundantie (in rollen en vermogens) en decentrale verbonden netwerken, zodat organisaties schokken kunnen absorberen, veerkrachtig worden en zich kunnen aanpassen zonder gecentraliseerde controle. Continue verandering wordt een bron van verbetering in plaats van bedreiging.</p><p>Zelforganisatie is primair een ecologisch principe: natuurlijke processen krijgen ruimte en vrijheid, in dynamische balans. Regeneratieve organisaties vertrouwen op hun eigen zelfregulerende vermogen en grijpen zo weinig in als nodig. Wanneer ingrijpen nodig wordt, gebeurt dat vanuit een cyclisch proces van observeren, evalueren en bijsturen. Maar zelforganisatie heeft ook een organisatorische dimensie: teams die zichzelf organiseren, communities of practice die organisch ontstaan, ecosystemen van partners die hun eigen balans vinden.</p><p>Dit principe vraagt om een fundamenteel andere organisatiehouding: niet de organisatie als machine die wordt gemanaged, maar als tuin die wordt verzorgd. Het werk is condities scheppen, blokkades verwijderen, structuren bouwen die zelforganisatie mogelijk maken. En dan: ruimte geven.</p>"},products:{activating:"Ontwerp voor zelforganisatie van gebruikers en ecosystemen",short:"Ontwerp producten die gebruikers en ecosystemen in staat stellen zichzelf te organiseren, aan te passen en te herstellen. Schep condities voor agency — modulair, repareerbaar, open.",full:"<p>Ontwerp producten die gebruikers, gemeenschappen en ecosystemen in staat stellen zichzelf te organiseren, aan te passen en te herstellen. Stimuleer diversiteit (in configuraties, reparatiemogelijkheden, gebruikscontexten), functionele redundantie (zodat producten bruikbaar blijven wanneer onderdelen falen) en open architecturen, zodat producten kunnen evolueren, aangepast worden en herstellen in plaats van weggegooid te worden. Continue verandering in gebruik en context wordt een bron van ontwerprijkdom in plaats van een probleem.</p><p>Zelforganisatie is primair een ecologisch principe: natuurlijke processen krijgen ruimte in dynamische balans. Regeneratief productontwerp vertrouwt op het aanpassingsvermogen van gebruikers en materialen — door te ontwerpen voor reparatie, modificatie en onverwacht gebruik in plaats van uitkomsten te controleren via geprogrammeerde veroudering. Wanneer herontwerp nodig is, gebeurt dat vanuit een cyclisch proces van gebruik observeren, prestaties evalueren en vorm aanpassen.</p><p>Dit principe vraagt om een fundamenteel andere ontwerphouding: niet het product als machine die gebruikersgedrag fixeert, maar als gereedschap dat het versterkt. Het werk is condities scheppen — via modulariteit, repareerbaarheid, open documentatie en gedeelde kennis — die zelforganisatie mogelijk maken. En dan: ruimte geven.</p>"}},
  5:{cities:{activating:"Heb aandacht voor al het leven",short:"Ontwerp met expliciete aandacht voor het samenleven van alle levensvormen. Natuur als actor, niet als dienstverlener. Zowel ecologische als sociale inclusie zijn essentieel.",full:"<p>Ontwerp met expliciete aandacht voor het samenleven van alle levensvormen: mensen, planten, dieren en microbiomen krijgen ruimte, verbinding en bescherming in het ontwerp. Dit principe erkent natuur niet als decoratie of dienstverlener, maar als actor met eigen belangen die evenwaardig worden meegewogen in ontwerp en beheer.</p><p>Dit principe heeft twee onafscheidelijke dimensies. De ecologische dimensie vraagt om natuur als medeontwerper te behandelen: habitats worden geïntegreerd, corridors verbonden, niet-menselijke soorten krijgen ruimte om te functioneren en te floreren. De sociale dimensie vraagt om alle menselijke groepen actief te betrekken, inclusief kwetsbare groepen waarvoor participatiebarrières expliciet worden weggenomen.</p><p>Beide dimensies zijn even essentieel. Een ontwerp dat natuur als stakeholder erkent maar bepaalde bevolkingsgroepen uitsluit, is niet regeneratief. Evenmin is een sociaal inclusief ontwerp dat de niet-menselijke wereld negeert regeneratief. Regeneratief ontwerpen vraagt om rechtvaardige betrokkenheid bij al het leven.</p>"},business:{activating:"Creëer waarde voor al het leven",short:"Creëer waarde met expliciete aandacht voor alle stakeholders: medewerkers, gemeenschappen, ecosystemen en niet-menselijk leven. Natuur als mede-begunstigde, niet als resource of risico. Zowel ecologische als sociale inclusie zijn essentieel.",full:"<p>Creëer waarde met expliciete aandacht voor alle stakeholders: medewerkers, klanten, gemeenschappen in de keten, lokale ecosystemen en niet-menselijk leven. Dit principe erkent natuur niet als een resource om te beheren of een risico om te mitigeren, maar als mede-begunstigde waarvan belangen evenwaardig worden meegewogen in bedrijfsbeslissingen en strategie.</p><p>Dit principe heeft twee onafscheidelijke dimensies. De ecologische dimensie vraagt om natuur als stakeholder te behandelen: ecosystemen worden ondersteund, biodiversiteit in de keten wordt behouden en opgebouwd, en niet-menselijke soorten krijgen aandacht in operationele en strategische beslissingen. De sociale dimensie vraagt om alle menselijke stakeholders actief te betrekken — inclusief degenen met de minste macht in het systeem — waarbij participatiebarrières expliciet worden weggenomen.</p><p>Beide dimensies zijn even essentieel. Een bedrijf dat natuur als stakeholder erkent maar zijn werknemers uitbuit, is niet regeneratief. Evenmin is een sociaal inclusief bedrijf dat de ecosystemen uitput waarvan het afhankelijk is regeneratief. Regeneratief ondernemen vraagt om rechtvaardige betrokkenheid bij al het leven — en maakt die betrokkenheid structureel, niet incidenteel.</p>"},products:{activating:"Ontwerp voor al het leven over de volledige levenscyclus",short:"Ontwerp met expliciete aandacht voor al het leven dat door het product wordt geraakt: gebruikers, makers, ecosystemen en niet-menselijk leven. Zowel ecologische als sociale inclusie zijn essentieel over de volledige levenscyclus.",full:"<p>Ontwerp met expliciete aandacht voor de volledige gemeenschap van leven die door een product wordt geraakt: de gebruikers die ermee omgaan, de makers die het produceren, de gemeenschappen die nabij productielocaties leven, de ecosystemen waaruit materialen komen en het niet-menselijke leven dat over de levenscyclus heen wordt beïnvloed. Dit principe erkent natuur niet als achtergrondbron van materiaal of bestemming voor afval, maar als gemeenschap van actoren waarvan belangen evenwaardig worden meegewogen in ontwerpbeslissingen.</p><p>Dit principe heeft twee onafscheidelijke dimensies. De ecologische dimensie vraagt om natuur als medeontwerper te behandelen: materialen komen uit levende systemen die worden ondersteund in plaats van uitgeput, productieprocessen zijn goedaardig voor omliggende ecosystemen en einde-levensduurontwerp houdt materialen in biologische of technische cycli. De sociale dimensie vraagt om alle menselijke groepen actief in ontwerp te betrekken — gebruikers van verschillende leeftijden, vermogens en economische contexten — waarbij barrières voor rechtvaardige toegang expliciet worden aangepakt en makers eerlijke en waardige omstandigheden krijgen.</p><p>Beide dimensies zijn even essentieel. Een product met ecologische zorg maar uitbuitende arbeid is niet regeneratief. Evenmin is een sociaal inclusief product dat op ecologisch destructieve materialen leunt regeneratief. Regeneratief productontwerp vraagt om rechtvaardige aandacht voor al het leven over de volledige levenscyclus.</p>"}},
  6:{cities:{activating:"Ontwerp voor toekomstige generaties",short:"Ontwerp met een expliciete langetermijnoriëntatie. Kortetermijnwinst mag langetermijnlevensvatbaarheid niet ondermijnen. Ontwerp voor aanpasbaarheid, niet alleen voor duurzaamheid.",full:"<p>Ontwerp met een expliciete langetermijnoriëntatie die de gevolgen van elke beslissing voor toekomstige generaties meeweegt. Door te ontwerpen met een tijdshorizon van decennia tot eeuwen zorg je dat bodemkwaliteit, biodiversiteit en sociale structuren niet alleen vandaag floreren, maar over vele generaties veerkrachtig blijven. Kortetermijnwinst mag langetermijnlevensvatbaarheid niet ondermijnen.</p><p>Dit principe verankert een ethiek van rentmeesterschap in ontwerpkeuzes: het gaat niet alleen om wat wij nu nodig hebben, maar om wat toekomstige generaties nodig zullen hebben. Dat vraagt om nederigheid over wat we vandaag kunnen weten. Toekomstige generaties zullen andere behoeften hebben dan wij. Ontwerpen voor de lange termijn betekent daarom ook ontwerpen voor aanpasbaarheid en flexibiliteit, niet alleen voor duurzaamheid. Een tijdelijk gebouw dat bewust is ontworpen om plaats te maken voor iets beters kan een even sterke uitdrukking van intergenerationeel denken zijn als een eeuwenoude structuur.</p>"},business:{activating:"Bouw voor toekomstige generaties",short:"Bouw met een expliciete langetermijnoriëntatie. Kortetermijnwinst mag langetermijnlevensvatbaarheid niet ondermijnen. Ontwerp voor eigendomsstructuren en aanpassingsvermogen — niet alleen voor huidige prestaties.",full:"<p>Bouw met een expliciete langetermijnoriëntatie die de gevolgen van elke beslissing voor toekomstige generaties meeweegt. Door te bouwen met een tijdshorizon van decennia tot generaties zorg je dat de organisatorische, ecologische en sociale structuren die je creëert niet alleen vandaag floreren, maar over vele generaties veerkrachtig blijven. Kortetermijnwinst mag langetermijnlevensvatbaarheid niet ondermijnen.</p><p>Dit principe verankert een ethiek van rentmeesterschap in bedrijfsbeslissingen: het gaat niet alleen om wat wij nu nodig hebben, maar om wat toekomstige stakeholders nodig zullen hebben. Dat vraagt om nederigheid over wat we vandaag kunnen weten. Toekomstige generaties zullen andere behoeften hebben dan de huidige. Bouwen voor de lange termijn betekent daarom ontwerpen voor eigendomsstructuren die de purpose beschermen en voor adaptief organisatorisch vermogen, niet alleen voor huidige financiële prestaties. Een bedrijfsmodel dat doelbewust is ontworpen om naar iets beters te evolueren — verankerd door steward ownership, purpose locks en patient capital — kan een even sterke uitdrukking van intergenerationeel denken zijn als een eeuwenoude instelling.</p>"},products:{activating:"Ontwerp voor toekomstige generaties en materiaalterugkeer",short:"Ontwerp met een tijdshorizon die verder reikt dan de huidige productcyclus. Ondermijn langetermijngezondheid van materialen niet voor kortetermijnprestaties. Ontwerp voor levensduur, repareerbaarheid en materiaalterugkeer — niet voor veroudering.",full:"<p>Ontwerp met een expliciete langetermijnoriëntatie die de gevolgen van elke materiaalkeuze en ontwerpbeslissing voor toekomstige generaties meeweegt. Door te ontwerpen met een tijdshorizon die ruim voorbij de huidige productcyclus reikt, zorg je dat de materialen die je gebruikt, de processen die je in gang zet en de gebruiksculturen die je creëert niet alleen vandaag functioneren, maar over vele levens heen levensvatbaar blijven. Kortetermijnmarktprestaties mogen langetermijngezondheid van materialen niet ondermijnen.</p><p>Dit principe verankert een ethiek van rentmeesterschap in ontwerpkeuzes: het gaat niet alleen om wat gebruikers nu nodig hebben, maar om wat toekomstige gebruikers, gemeenschappen en ecosystemen nodig zullen hebben. Dat vraagt om nederigheid over wat we kunnen voorspellen. Toekomstige gebruikscontexten zullen verschillen van huidige. Ontwerpen voor de lange termijn betekent daarom ontwerpen voor levensduur, repareerbaarheid en materiaalterugkeer — niet alleen voor initiële prestaties. Een product dat doelbewust is ontworpen om gerepareerd, geüpgraded en teruggebracht te worden in materiaalcycli kan een even sterke uitdrukking van intergenerationeel denken zijn als een product dat gebouwd is om een eeuw onveranderd mee te gaan.</p>"}},
  7:{cities:{activating:"Bouw nieuwe regeneratieve culturen",short:"Ontwerp gericht op het versterken en vernieuwen van sociaal-culturele weefsels: zorg, vertrouwen, wederkerigheid en gedeeld eigenaarschap door verbinding.",full:"<p>Ontwerp gericht op het versterken en vernieuwen van sociaal-culturele weefsels: zorg, vertrouwen, wederkerigheid en gedeeld eigenaarschap door verbinding. Dit principe erkent dat regeneratieve verandering fundamenteel culturele verandering is. Technische en ecologische interventies hebben alleen blijvende impact wanneer ze geworteld zijn in een andere manier van leven, van eigenaarschap, van omgaan met plek en gemeenschap.</p><p>Gemeenschappen die zichzelf verantwoordelijk voelen voor hun leefomgeving — die samen beheren, samen besluiten, samen zorgen — zijn de dragers van regeneratieve transitie. Gedeeld eigenaarschap, co-creatie en lokale initiatieven zijn geen bijproducten maar kernopgaven. Een regeneratieve cultuur mag geen culturele elite zijn: de paradigmaverschuiving moet bruggen slaan naar brede maatschappelijke lagen, niet een eiland blijven voor een kleine groep gelijkgestemden.</p><p>Dit is van alle acht principes het meest veeleisende. Het vraagt niet alleen om andere methoden, maar om een andere basishouding ten opzichte van eigenaarschap, controle en groei. Precies daarom is het bouwen van nieuwe regeneratieve culturen geen slothoofdstuk van ontwerp, maar het vertrekpunt.</p>"},business:{activating:"Bouw nieuwe regeneratieve organisatieculturen",short:"Bouw gericht op het versterken en vernieuwen van organisatie- en gemeenschapscultuur: zorg, vertrouwen, wederkerigheid en gedeeld eigenaarschap door verbinding. Regeneratieve bedrijfsverandering is fundamenteel culturele verandering.",full:"<p>Bouw gericht op het versterken en vernieuwen van organisatie- en gemeenschapsculturen: zorg, vertrouwen, wederkerigheid en gedeeld eigenaarschap door verbinding. Dit principe erkent dat regeneratieve verandering in bedrijven fundamenteel culturele verandering is. Strategische en operationele interventies hebben alleen blijvende impact wanneer ze geworteld zijn in een andere manier van werken, van bezitten en van omgaan met het doel van de organisatie.</p><p>Organisaties die zichzelf verantwoordelijk zien voor de gezondheid van hun gemeenschappen en ecosystemen — die co-creëren, rentmeesterschap delen en samen zorgen — zijn de dragers van regeneratieve bedrijfstransitie. Gedeeld eigenaarschap, co-creatie met stakeholders en lokaal gewortelde initiatieven zijn geen bijproducten maar kernopgaven. Een regeneratieve organisatiecultuur mag geen leiderschapselite zijn: de paradigmaverschuiving moet bruggen slaan naar alle lagen van de organisatie en de gemeenschappen die zij raakt, niet een eiland blijven voor een toegewijde kleine groep.</p><p>Dit is van alle acht principes het meest veeleisende voor bedrijven. Het vraagt niet alleen om andere strategieën, maar om een andere basishouding ten opzichte van eigenaarschap, controle en groei — het loslaten van patronen die diep ingebed zijn in hoe organisaties zijn gestructureerd en hoe mensen zichzelf als professionals begrijpen. Precies daarom is het bouwen van nieuwe regeneratieve culturen geen slothoofdstuk van bedrijfstransformatie, maar het vertrekpunt.</p>"},products:{activating:"Ontwerp producten die regeneratieve cultuur dragen en opbouwen",short:"Ontwerp gericht op producten die regeneratieve cultuur dragen en versterken: zorg, reparatie, wederkerigheid en gedeelde betekenis. Producten zijn culturele artefacten.",full:"<p>Ontwerp gericht op producten die regeneratieve cultuur dragen en opbouwen: zorg, reparatie, wederkerigheid en gedeelde betekenis. Dit principe erkent dat producten culturele artefacten zijn — geen neutrale objecten maar actieve deelnemers aan de culturen die ze maken en gebruiken. Ze communiceren waarden, maken praktijken mogelijk of onmogelijk en versterken of verzwakken de relaties tussen mensen, gemeenschappen en levende systemen. Regeneratieve verandering in materiële cultuur is fundamenteel culturele verandering.</p><p>Producten die reparatie uitnodigen in plaats van vervanging, die gebruikssporen met waardigheid dragen, die gebruikers verbinden met de gemeenschappen en ecosystemen waaruit ze voortkomen — dat zijn de culturele dragers van regeneratieve transitie. Ontwerpen voor zorg, onderhoud, vaardigheid en hechting is geen ontwerpbeperking maar een kernopgave. Een regeneratieve materiële cultuur mag geen premium niche zijn: de waardeverandering moet ingebed zijn in alledaagse objecten die toegankelijk zijn voor brede bevolkingsgroepen, niet beperkt blijven tot high-end uitzonderingen.</p><p>Dit is van alle acht principes het meest transformerende voor productontwerp. Het vraagt niet alleen om andere materialen en processen, maar om een andere basishouding ten opzichte van waar producten voor zijn — het loslaten van patronen die diep ingebed zijn in consumentencultuur: de verwachting van nieuwheid, de devaluatie van reparatie, de verbreking tussen producten en hun herkomst. Precies daarom is ontwerpen voor regeneratieve cultuur geen finishing touch op een productstrategie, maar haar eerste principe.</p>"}},
  8:{cities:{activating:"Bestuur als gemeenschap",short:"Ontwerp governance-structuren, besluitvorming en eigendomsmodellen die langdurige zorg en collectief rentmeesterschap mogelijk maken.",full:"<p>Ontwerp governance-structuren, besluitvorming en eigendomsmodellen die langdurige zorg en collectief rentmeesterschap mogelijk maken. Technische en ecologische interventies die niet worden ondersteund door passende institutionele kaders verliezen snel hun regeneratieve effect. Goed ontworpen governance is daarom geen randvoorwaarde, maar een integraal onderdeel van het ontwerp zelf.</p><p>Kies waar mogelijk voor commonsmodellen, coöperaties of steward-ownership-structuren die ervoor zorgen dat beheer, toegang en waardecreatie ten goede komen aan de gemeenschap en het ecosysteem. Commons-vormen versterken transparantie, betrokkenheid en continuïteit, en zorgen dat publieke en semi-publieke infrastructuur niet wordt uitgehold of geprivatiseerd ten koste van ecologische en sociale doelen.</p><p>Governance moet ook evolueren. Adaptieve governance — lerend en evaluerend werken, met ruimte voor aanpassing zonder langetermijndoelen te verliezen — is een kernkwaliteit van regeneratief rentmeesterschap. Zo ontstaan veerkrachtige netwerken waarin gebruikers meebeslissen, meedragen en meedelen, en waarin zorg voor een plek over generaties heen kan worden doorgegeven.</p>"},business:{activating:"Bestuur als een gemeenschap van purpose",short:"Ontwerp governance-structuren, eigendomsmodellen en besluitvorming die langdurige zorg, collectief rentmeesterschap en bescherming van regeneratieve purpose tegen extractie mogelijk maken.",full:"<p>Ontwerp governance-structuren, eigendomsmodellen en besluitvormingsprocessen die langdurige zorg, collectief rentmeesterschap en bescherming van regeneratieve purpose tegen extractie mogelijk maken. Strategische en operationele beslissingen die niet worden ondersteund door passende institutionele structuren verliezen snel hun regeneratieve effect. Goed ontworpen governance is daarom geen randvoorwaarde, maar een integraal onderdeel van het bedrijfsontwerp zelf.</p><p>Kies waar mogelijk voor steward-ownership-modellen, coöperaties of purpose-lock-structuren die ervoor zorgen dat beheer, toegang en waardecreatie ten goede komen aan de gemeenschap, ecosystemen en missie — in plaats van aan externe aandeelhouders die optimaliseren voor financieel rendement. Deze structuren versterken transparantie, betrokkenheid en continuïteit, en zorgen dat bedrijfswaarde niet door kortetermijndruk van eigenaarschap wordt weggeleid van ecologische en sociale doelen.</p><p>Governance moet ook evolueren. Adaptieve governance — lerend en evaluerend, met ruimte voor aanpassing zonder langetermijnpurpose te verliezen — is een kernkwaliteit van regeneratief ondernemend rentmeesterschap. Zo ontstaan veerkrachtige netwerken waarin alle stakeholders meebeslissen, meedragen en meedelen, en waarin zorg voor een purpose over generaties heen kan worden doorgegeven.</p>"},products:{activating:"Open je ontwerp als commons",short:"Ontwerp producten, platforms en intellectueel eigendom waar mogelijk als commons. Maak collectieve zorg, reparatie, aanpassing en rentmeesterschap mogelijk over de levenscyclus van het product.",full:"<p>Ontwerp producten, platforms en intellectueel eigendom waar mogelijk als commons. Maak collectieve zorg, reparatie, aanpassing en rentmeesterschap mogelijk over de levenscyclus van het product. Technische en ecologische ontwerpkeuzes die niet worden ondersteund door passende toegangs- en eigendomsstructuren verliezen snel hun regeneratieve effect: wanneer reparatiekennis eigendom is, wanneer materialen niet veilig geïdentificeerd en teruggewonnen kunnen worden, wanneer gemeenschappen producten niet aan hun behoeften kunnen aanpassen.</p><p>Kies waar mogelijk voor open design, right-to-repair-architecturen, gedeelde materiaalbibliotheken of commons-gebaseerde platforms die ervoor zorgen dat beheer, toegang en waardecreatie ten goede komen aan gebruikers, makers en ecosystemen — in plaats van waarde te concentreren op manieren die regeneratief gebruik ondermijnen. Open structuren versterken gemeenschapsbetrokkenheid, transparantie en continuïteit, en zorgen dat productwaarde niet wordt weggevangen van ecologische en sociale doelen door beperkende IP of ingebouwde lock-in.</p><p>Productgovernance moet ook evolueren. Adaptief rentmeesterschap — lerend en evaluerend, met ruimte voor gemeenschappen om aan te passen zonder regeneratieve ontwerpintegriteit te verliezen — is een kernkwaliteit van regeneratieve productontwikkeling. Zo ontstaan veerkrachtige netwerken van makers, gebruikers en reparatiegemeenschappen waarin de zorg voor een ontwerp over generaties heen kan worden doorgegeven.</p>"}}
};

type PxDomainKey = 'cities' | 'business' | 'products';
type PxPrincipleKey = 1|2|3|4|5|6|7|8;
interface PxEntry { activating: string; short: string; full: string; }

let pxState: {domain: PxDomainKey; principle: PxPrincipleKey} = {domain:'cities',principle:1};

function pxSelectDomain(d: string) {
  pxState.domain = d as PxDomainKey;
  document.querySelectorAll('.px-domain-tab').forEach(t => (t as HTMLElement).classList.toggle('active', (t as HTMLElement).dataset.domain === d));
  pxRender();
}
function pxSelectPrinciple(p: number) {
  pxState.principle = p as PxPrincipleKey;
  document.querySelectorAll('.px-pcard').forEach(c => (c as HTMLElement).classList.toggle('active', +(c as HTMLElement).dataset.p! === p));
  pxRender();
  document.getElementById('px-detail')!.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function pxNavigate(delta: number) {
  const next = pxState.principle + delta;
  if (next < 1 || next > 8) return;
  pxSelectPrinciple(next);
}
function pxRender() {
  const {domain, principle} = pxState;
  const data = (PX_DATA as Record<number, Record<string, PxEntry>>)[principle][domain];
  const num = String(principle).padStart(2,'0');
  const strip = document.getElementById('px-detail-strip')!;
  strip.className = 'h-[5px] bg-green ' + (domain === 'cities' ? '' : domain);
  document.getElementById('px-detail-num')!.textContent = num;
  document.getElementById('px-detail-title')!.textContent = PX_NAMES[principle-1];
  document.getElementById('px-detail-activating')!.textContent = data.activating;
  document.getElementById('px-detail-short')!.textContent = data.short;
  document.getElementById('px-detail-body')!.innerHTML = data.full;
  document.getElementById('px-nav-progress')!.textContent = principle + ' / 8';
  (document.getElementById('px-nav-prev') as HTMLButtonElement).disabled = principle === 1;
  (document.getElementById('px-nav-next') as HTMLButtonElement).disabled = principle === 8;
  document.getElementById('px-detail')!.classList.add('visible');
}

document.querySelectorAll('.px-domain-tab').forEach(btn => {
  btn.addEventListener('click', () => pxSelectDomain((btn as HTMLElement).dataset.domain!));
});
document.querySelectorAll('.px-pcard').forEach(btn => {
  btn.addEventListener('click', () => pxSelectPrinciple(+(btn as HTMLElement).dataset.p!));
});
document.getElementById('px-nav-prev')?.addEventListener('click', () => pxNavigate(-1));
document.getElementById('px-nav-next')?.addEventListener('click', () => pxNavigate(1));
</script>
