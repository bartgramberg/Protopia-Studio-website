---
interface ProjectExample {
  title: string
  description: string
  href: string
  image?: string
}

interface Props {
  projects: ProjectExample[]
  label: string
  tags?: string[]
}

const { projects, label, tags = [] } = Astro.props
const project = projects[0]            // only the first project
const visibleTags = tags.slice(0, 3)   // max 3 tags
---
<div class="flex flex-col max-w-[320px]">
  {project && (
    <a
      href={project.href}
      class="block bg-white rounded-lg overflow-hidden border border-border transition-shadow hover:shadow-[0_6px_20px_rgba(72,115,91,0.10)]"
    >
      {project.image && (
        <div class="aspect-[4/3] bg-creme overflow-hidden">
          <img src={project.image} alt={project.title} class="w-full h-full object-cover" loading="lazy" />
        </div>
      )}
      <div class="px-5 py-4">
        <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-light mb-1.5">{label}</div>
        <div class="text-[14px] font-bold text-green mb-1.5 leading-snug">{project.title}</div>
        <p class="text-[12px] text-mid leading-[1.55]">{project.description}</p>
      </div>
    </a>
  )}
  {visibleTags.length > 0 && (
    <div class="mt-4 flex flex-nowrap gap-1.5 overflow-hidden">
      {visibleTags.map(tag => (
        <span class="text-[10.5px] text-mid bg-[rgba(72,115,91,0.07)] px-2 py-[2px] rounded-[3px] whitespace-nowrap">{tag}</span>
      ))}
    </div>
  )}
</div>
